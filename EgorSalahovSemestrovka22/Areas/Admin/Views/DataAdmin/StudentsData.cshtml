@model List<EgorSalahovSemestrovka22.Models.Entities.Student>

@{
    ViewData["Title"] = "Students Data";
}

<div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
    <div class="breadcrumb-title pe-3">Data Tables</div>
    <div class="ps-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 p-0">
                <li class="breadcrumb-item"><a href="javascript:;"><i class="bx bx-home-alt"></i></a></li>
                <li class="breadcrumb-item active">Students</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Students Table</h5>
        <span class="badge bg-primary">@Model.Count records</span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Full Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Gender</th>
                        <th>Date of Birth</th>
                        <th>Registered</th>
                        <th>Courses</th>
                        <th>Orders</th>
                        <th>Bio</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td>@student.Id</td>
                            <td>
                                <strong>@student.FirstName @student.LastName</strong>
                            </td>
                            <td>@@@student.UserName</td>
                            <td>@student.Email</td>
                            <td>@student.PhoneNumber</td>
                            <td>
                                <span class="badge @(student.Gender == "Male" ? "bg-info" : "bg-pink")">
                                    @student.Gender
                                </span>
                            </td>
                            <td>@student.DateOfBirth.ToString("dd.MM.yyyy")</td>
                            <td>@student.RegistrationDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                <span class="badge bg-success">@student.Enrollments.Count</span>
                            </td>
                            <td>
                                <span class="badge bg-warning">@student.Orders.Count</span>
                            </td>
                            <td>
                                <small>@student.Bio</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
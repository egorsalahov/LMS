@model List<EgorSalahovSemestrovka22.Models.Entities.Instructors.Instructor>

@{
    ViewData["Title"] = "Instructors Data";
}

<div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
    <div class="breadcrumb-title pe-3">Data Tables</div>
    <div class="ps-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 p-0">
                <li class="breadcrumb-item"><a href="javascript:;"><i class="bx bx-home-alt"></i></a></li>
                <li class="breadcrumb-item active">Instructors</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Instructors Table</h5>
        <span class="badge bg-primary">@Model.Count records</span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Full Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Gender</th>
                        <th>Registered</th>
                        <th>Courses</th>
                        <th>Total Earnings</th>
                        <th>Bio</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var instructor in Model)
                    {
                        <tr>
                            <td>@instructor.Id</td>
                            <td>
                                <strong>@instructor.FirstName @instructor.LastName</strong>
                            </td>
                            <td>@@@instructor.UserName</td>
                            <td>@instructor.Email</td>
                            <td>@instructor.PhoneNumber</td>
                            <td>
                                <span class="badge @(instructor.Gender == "Male" ? "bg-info" : "bg-pink")">
                                    @instructor.Gender
                                </span>
                            </td>
                            <td>@instructor.RegistrationDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                <span class="badge bg-success">@instructor.Courses.Count</span>
                            </td>
                            <td>$@instructor.TotalEarnings</td>
                            <td>
                                <small>@instructor.Bio</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
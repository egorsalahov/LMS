@{
    ViewData["Title"] = "Analysis";
}

<!--breadcrumb-->
<div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
    <div class="breadcrumb-title pe-3">Dashboard</div>
    <div class="ps-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 p-0">
                <li class="breadcrumb-item">
                    <a href="javascript:;"><i class="bx bx-home-alt"></i></a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Analysis</li>
            </ol>
        </nav>
    </div>
    <div class="ms-auto">
    </div>
</div>
<!--end breadcrumb-->

<div class="row">
    <div class="col-12 mt-4">
        <div class="card w-100 rounded-4">
            <div class="card-body">
                <h5 class="mb-0 mb-3">User Registrations Over Time</h5>
                <div id="registrationChart" style="min-height:350px;"></div>
            </div>
        </div>
    </div>
    <div class="col-xl-6 col-xxl-3 d-flex align-items-stretch">
        <div class="card w-100 rounded-4">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="">
                        <h5 class="mb-0">@ViewBag.TotalUsers</h5>
                        <p class="mb-0">Total Users</p>
                    </div>
                </div>
                <div class="chart-container2">
                    <div id="chart2"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-6 col-xxl-4 d-flex align-items-stretch">
        <div class="card w-100 rounded-4">
            <div class="card-header border-0 p-3 border-bottom">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="">
                        <h5 class="mb-0">New Users</h5>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="user-list p-3">
                    <div class="d-flex flex-column gap-3">
                        @if (ViewBag.NewUsers != null)
                        {
                            foreach (var user in ViewBag.NewUsers)
                            {
                                <div class="d-flex align-items-center gap-3">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0">@user.FirstName @user.LastName</h6>
                                        <p class="mb-0">@user.UserName</p>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-12 col-xxl-8 d-flex align-items-stretch">
        <div class="card w-100 rounded-4">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div class="">
                        <h5 class="mb-0">Recent Orders</h5>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Customer</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.RecentOrders != null)
                            {
                                foreach (var order in ViewBag.RecentOrders)
                                {
                                    <tr>
                                        <td>#ORD@(order.Id.ToString("D3"))</td>
                                        <td>@order.CustomerName</td>
                                        <td>$@order.TotalAmount.ToString("0.00")</td>
                                        <td><p class="dash-lable mb-0 bg-@(order.OrderStatus == "Completed" ? "success" : "warning") bg-opacity-10 text-@(order.OrderStatus == "Completed" ? "success" : "warning") rounded-2">@order.OrderStatus</p></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/plugins/admin/apexchart/apexcharts.min.js"></script>
    <script>
        if ($('.user-list').length) {
        new PerfectScrollbar(".user-list");
        }

        // Данные из ViewBag
        var registrationData = @Html.Raw(Json.Serialize(ViewBag.RegistrationData ?? new List<object>()));

        var categories = registrationData.map(function (item) { return item.label; });
        var studentsData = registrationData.map(function (item) { return item.students; });
        var instructorsData = registrationData.map(function (item) { return item.instructors; });

        var options = {
        chart: {
        type: 'area',
        height: 350,
        toolbar: { show: false }
        },
        series: [
        { name: 'Students', data: studentsData },
        { name: 'Instructors', data: instructorsData }
        ],
        xaxis: { categories: categories },
        colors: ['#0d6efd', '#6f42c1'],
        fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.4, opacityTo: 0.1 } },
        stroke: { curve: 'smooth', width: 2 },
        legend: { position: 'top' },
        tooltip: { y: { formatter: function (val) { return val + ' users'; } } }
        };

        var chart = new ApexCharts(document.querySelector("#registrationChart"), options);
        chart.render();
    </script>
}
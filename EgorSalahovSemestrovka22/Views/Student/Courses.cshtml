@model List<EgorSalahovSemestrovka22.Models.Entities.Enrollment>
@{
    ViewData["Title"] = "Enrolled Courses";
}

<!-- Main Wrapper -->
<div class="main-wrapper">
    <!-- Breadcrumb -->
    <div class="breadcrumb-bar text-center">
        <div class="container">
            <div class="row">
                <div class="col-md-12 col-12">
                    <h2 class="breadcrumb-title mb-2">Enrolled Courses</h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb justify-content-center mb-0">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Enrolled Courses</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    <!-- /Breadcrumb -->

    <div class="content">
        <div class="container">
            <div class="row">
                @await Html.PartialAsync("_StudentSidebar")
                <div class="col-lg-9">
                    <div class="page-title d-flex flex-wrap gap-3 align-items-center justify-content-between">
                        <h5>Enrolled Courses</h5>
                    </div>
                    <div class="tab-content">
                        <div class="tab-pane fade active show" id="enroll-courses" role="tabpanel">
                            <div class="row">
                                @if (!Model.Any())
                                {
                                    <div class="col-12 text-center py-5">
                                        <p class="text-muted">You haven't enrolled in any courses yet.</p>
                                        <a asp-controller="Course" asp-action="List" class="btn btn-primary">Browse Courses</a>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var enrollment in Model)
                                    {
                                        var course = enrollment.Course;
                                        var avgRating = course.Reviews?.Any() == true
                                            ? course.Reviews.Average(r => r.Rating)
                                            : 0;
                                        var reviewCount = course.Reviews?.Count ?? 0;
                                        var imageUrl = string.IsNullOrEmpty(course.ImagePath) || !course.ImagePath.StartsWith("/")
                                            ? "/img/default.jpg"
                                            : course.ImagePath;

                                        <div class="col-xl-4 col-md-6 d-flex">
                                            <div class="course-item-two course-item mx-0">
                                                <div class="course-img">
                                                    <a asp-controller="Student" asp-action="WatchCourse" asp-route-enrollmentId="@enrollment.Id">
                                                        <img src="@imageUrl" alt="@course.Title" class="img-fluid" onerror="this.src='/img/default.jpg'">
                                                    </a>
                                                    <div class="position-absolute start-0 top-0 d-flex align-items-start w-100 z-index-2 p-3">
                                                        @if (course.OldPrice.HasValue)
                                                        {
                                                            var discount = (int)((course.OldPrice.Value - course.Price) / course.OldPrice.Value * 100);
                                                            <div class="badge text-bg-danger">@discount% off</div>
                                                        }
                                                        <a href="javascript:void(0);" class="fav-icon ms-auto"><i class="isax isax-heart"></i></a>
                                                    </div>
                                                </div>
                                                <div class="course-content">
                                                    <div class="d-flex justify-content-between mb-2">
                                                        <div class="d-flex align-items-center">
                                                            <div class="avatar avatar-sm">
                                                                @if (!string.IsNullOrEmpty(course.Instructor?.AvatarPath))
                                                                {
                                                                    <img src="@course.Instructor.AvatarPath" class="rounded-circle" alt="" onerror="this.style.display='none'; this.parentElement.innerHTML='<span class=\'d-flex align-items-center justify-content-center bg-secondary text-white rounded-circle\' style=\'width:100%;height:100%;font-size:10px;\'>@(course.Instructor?.FirstName?.FirstOrDefault())@(course.Instructor?.LastName?.FirstOrDefault())</span>';">
                                                                }
                                                                else
                                                                {
                                                                    <span class="d-flex align-items-center justify-content-center bg-secondary text-white rounded-circle" style="width:100%;height:100%;font-size:10px;">
                                                                        @(course.Instructor?.FirstName?.FirstOrDefault())@(course.Instructor?.LastName?.FirstOrDefault())
                                                                    </span>
                                                                }
                                                            </div>
                                                            <div class="ms-2">
                                                                <a href="#" class="link-default fs-14">@(course.Instructor?.FirstName ?? "Instructor") @(course.Instructor?.LastName ?? "")</a>
                                                            </div>
                                                        </div>
                                                        <span class="badge badge-light rounded-pill bg-light d-inline-flex align-items-center fs-13 fw-medium mb-0">
                                                            @course.Category?.Name
                                                        </span>
                                                    </div>
                                                    <h6 class="title mb-2">
                                                        <a asp-controller="Student" asp-action="WatchCourse" asp-route-enrollmentId="@enrollment.Id">@course.Title</a>
                                                    </h6>
                                                    <p class="d-flex align-items-center mb-3">
                                                        <i class="fa-solid fa-star text-warning me-2"></i>@avgRating.ToString("0.0") (@reviewCount Reviews)
                                                    </p>
                                                    <div class="d-flex align-items-center justify-content-between">
                                                        <h5 class="text-secondary mb-0">
                                                            @if (course.Price == 0)
                                                            {
                                                                <span>FREE</span>
                                                            }
                                                            else
                                                            {
                                                                <span>$@course.Price</span>
                                                            }
                                                        </h5>
                                                        <a asp-controller="Student" asp-action="WatchCourse" asp-route-enrollmentId="@enrollment.Id" class="btn btn-dark btn-sm d-inline-flex align-items-center">
                                                            View Course<i class="isax isax-arrow-right-3 ms-1"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .course-item-two {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .course-item-two .course-img {
            height: 200px;
            overflow: hidden;
        }

            .course-item-two .course-img img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .course-item-two .course-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

    .row > [class*="col-"] {
        margin-bottom: 24px;
    }
</style>
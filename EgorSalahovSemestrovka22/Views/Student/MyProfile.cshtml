@model EgorSalahovSemestrovka22.Models.Entities.Student
@{
    ViewData["Title"] = "My Profile";
    var editMode = ViewData["EditMode"] as bool? == true;
}

<!-- Main Wrapper -->
<div class="main-wrapper">
    <!-- Breadcrumb -->
    <div class="breadcrumb-bar text-center">
        <div class="container">
            <div class="row">
                <div class="col-md-12 col-12">
                    <h2 class="breadcrumb-title mb-2">My Profile</h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb justify-content-center mb-0">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">My Profile</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    <!-- /Breadcrumb -->

    <div class="content">
        <div class="container">
            <!-- profile box -->
            <div class="profile-card overflow-hidden bg-blue-gradient2 mb-5 p-5">
                <div class="profile-card-bg">
                    <img src="~/img/bg/card-bg-01.png" class="profile-card-bg-1" alt="">
                </div>
                <div class="row align-items-center row-gap-3">
                    <div class="col-lg-6">
                        <div class="d-flex align-items-center">
                            <span class="avatar avatar-xxl avatar-rounded me-3 border border-white border-2 position-relative">
                                @if (!string.IsNullOrEmpty(Model.AvatarPath) && Model.AvatarPath.StartsWith("/"))
                                {
                                    <img src="@Model.AvatarPath" alt="" onerror="this.style.display='none'; this.parentElement.querySelector('.avatar-initials').style.display='flex';">
                                    <span class="avatar-initials d-flex align-items-center justify-content-center bg-light text-primary" style="width:100%;height:100%;font-size:28px;font-weight:bold;display:none;border-radius:50%;">
                                        @Model.FirstName?.FirstOrDefault()@Model.LastName?.FirstOrDefault()
                                    </span>
                                }
                                else
                                {
                                    <span class="d-flex align-items-center justify-content-center bg-light text-primary" style="width:100%;height:100%;font-size:28px;font-weight:bold;border-radius:50%;">
                                        @Model.FirstName?.FirstOrDefault()@Model.LastName?.FirstOrDefault()
                                    </span>
                                }
                                <span class="verify-tick"><i class="isax isax-verify5"></i></span>
                            </span>
                            <div>
                                <h5 class="mb-1 text-white d-inline-flex align-items-center">
                                    @Model.FirstName @Model.LastName
                                    <a href="javascript:void(0)" class="link-light fs-16 ms-2 edit-profile-icon"><i class="isax isax-edit-2"></i></a>
                                </h5>
                                <p class="text-light">Student</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="d-flex align-items-center justify-content-lg-end flex-wrap gap-2">
                            <a asp-controller="Student" asp-action="BecomeInstructor" class="btn btn-white rounded-pill me-3">Become an Instructor</a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- profile box -->

            <div class="row">
                @await Html.PartialAsync("_StudentSidebar")
                <div class="col-lg-9">
                    <div class="page-title d-flex align-items-center justify-content-between">
                        <h5 class="fw-bold">My Profile</h5>
                        <a href="javascript:void(0)" class="edit-profile-icon"><i class="isax isax-edit-2"></i></a>
                    </div>

                    <!-- Success message -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }

                    <!-- View mode -->
                    <div class="card mb-0" id="profile-view" @(editMode ? "style=display:none" : "")>
                        <div class="card-body">
                            <h6 class="fs-18 page-title fw-bold">Basic Information</h6>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <h6>First Name</h6>
                                        <span>@(Model.FirstName ?? "-")</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <h6>Last Name</h6>
                                        <span>@(Model.LastName ?? "-")</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <h6>Registration Date</h6>
                                        <span>@Model.RegistrationDate.ToString("dd MMM yyyy, HH:mm")</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <h6>Phone Number</h6>
                                        <span>@(Model.PhoneNumber ?? "-")</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <h6>Email</h6>
                                        <span>@Model.Email</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <h6>Gender</h6>
                                        <span>@(Model.Gender ?? "-")</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <h6>DOB</h6>
                                        <span>@Model.DateOfBirth.ToString("dd MMM yyyy")</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <h6>Age</h6>
                                        @{
                                            var age = DateTime.Now.Year - Model.DateOfBirth.Year;
                                            if (DateTime.Now.DayOfYear < Model.DateOfBirth.DayOfYear) { age--; }
                                        }
                                        <span>@age</span>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div>
                                        <h6>Bio</h6>
                                        <span>@Html.Raw(Model.Bio ?? "-")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Edit mode -->
                    <div class="card mb-0" id="profile-edit" @(editMode ? "" : "style=display:none")>
                        <div class="card-body">
                            <h6 class="fs-18 page-title fw-bold">Edit Profile</h6>
                            <form asp-action="EditProfile" method="post" id="editProfileForm">
                                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="input-block mb-3">
                                            <label class="form-label">First Name<span class="text-danger">*</span></label>
                                            <input name="FirstName" class="form-control" value="@Model.FirstName" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-block mb-3">
                                            <label class="form-label">Last Name<span class="text-danger">*</span></label>
                                            <input name="LastName" class="form-control" value="@Model.LastName" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-block mb-3">
                                            <label class="form-label">Gender<span class="text-danger">*</span></label>
                                            <select name="Gender" class="form-select">
                                                <option value="">Select</option>
                                                <option value="Male" selected="@(Model.Gender == "Male")">Male</option>
                                                <option value="Female" selected="@(Model.Gender == "Female")">Female</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-block mb-3">
                                            <label class="form-label">Phone Number</label>
                                            <input name="PhoneNumber" id="phone-input" class="form-control" type="tel"
                                                   value="@Model.PhoneNumber"
                                                   placeholder="+7 (999) 999-99-99" />
                                            <span class="text-danger fs-12" id="phone-error"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-block mb-3">
                                            <label class="form-label">Date of Birth<span class="text-danger">*</span></label>
                                            <input name="DateOfBirth" class="form-control" type="date" value="@Model.DateOfBirth.ToString("yyyy-MM-dd")" />
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="input-block mb-3">
                                            <label class="form-label">Bio</label>
                                            <textarea name="Bio" class="form-control summernote">@Model.Bio</textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <button type="button" class="btn btn-light me-2" id="cancelEditBtn">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save Changes</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-bs4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/inputmask@5.0.9/dist/jquery.inputmask.min.js"></script>
    <script>
        $(function () {
        // Summernote
        $('.summernote').summernote({
        height: 200,
        toolbar: [
        ['style', ['bold', 'italic', 'underline', 'clear']],
        ['fontsize', ['fontsize']],
        ['color', ['color']],
        ['para', ['ul', 'ol', 'paragraph']],
        ['insert', ['link']]
        ]
        });

        var originalBio = @Html.Raw(Json.Serialize(Model.Bio ?? ""));

        // Маска телефона
        $('#phone-input').inputmask({
        mask: '+7 (999) 999-99-99',
        placeholder: '_',
        showMaskOnHover: false,
        showMaskOnFocus: true,
        onincomplete: function () {
        $('#phone-error').text('Введите полный номер телефона');
        },
        oncomplete: function () {
        $('#phone-error').text('');
        }
        });

        // Переключение режимов
        $('.edit-profile-icon').click(function () {
        $('#profile-view').hide();
        $('#profile-edit').show();
        });

        $('#cancelEditBtn').click(function () {
        $('#profile-edit').hide();
        $('#profile-view').show();
        document.getElementById('editProfileForm').reset();
        $('.summernote').summernote('code', originalBio);
        $('#phone-error').text('');
        });

        // Валидация телефона перед отправкой
        $('#editProfileForm').on('submit', function (e) {
        var phone = $('#phone-input').val().replace(/\D/g, '');
        if (phone && phone.length !== 11) {
        e.preventDefault();
        $('#phone-error').text('Номер должен содержать 11 цифр');
        return false;
        }
        $('#phone-error').text('');
        });

        @if (editMode)
        {
            <text>
                $('#profile-view').hide();
                $('#profile-edit').show();
            </text>
        }
        });
    </script>
}
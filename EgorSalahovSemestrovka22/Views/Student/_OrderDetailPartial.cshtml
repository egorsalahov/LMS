@model EgorSalahovSemestrovka22.Models.Entities.Orders.Order

<div class="row mb-3">
    <div class="col-md-6">
        <h6 class="fw-bold">Order #ORD@(Model.Id.ToString("D3"))</h6>
        <p class="mb-1"><strong>Date:</strong> @Model.OrderDate.ToString("dd MMM yyyy, HH:mm")</p>
        <p class="mb-1">
            <strong>Status:</strong>
            <span class="badge @(Model.OrderStatus == "Completed" ? "bg-success" : "bg-warning")">@Model.OrderStatus</span>
        </p>
        <p class="mb-1"><strong>Payment Method:</strong> @Model.PaymentMethod</p>
    </div>
    <div class="col-md-6">
        <h6 class="fw-bold">Billing Address</h6>
        <p class="mb-1">@Model.FirstName @Model.LastName</p>
        <p class="mb-1">@Model.AddressLine1</p>
        @if (!string.IsNullOrEmpty(Model.AddressLine2))
        {
            <p class="mb-1">@Model.AddressLine2</p>
        }
        <p class="mb-1">@Model.City, @Model.State, @Model.Country</p>
    </div>
</div>

<h6 class="fw-bold">Items</h6>
<table class="table table-sm">
    <thead>
        <tr>
            <th>Course</th>
            <th>Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderItems)
        {
            <tr>
                <td>@item.Course?.Title</td>
                <td>$@item.PriceAtPurchase.ToString("0.00")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td><strong>Tax</strong></td>
            <td>$@Model.Tax.ToString("0.00")</td>
        </tr>
        <tr>
            <td><strong>Total</strong></td>
            <td><strong>$@Model.TotalAmount.ToString("0.00")</strong></td>
        </tr>
    </tfoot>
</table>
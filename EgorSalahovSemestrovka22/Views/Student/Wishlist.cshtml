@model List<EgorSalahovSemestrovka22.Models.Entities.Wishlist>
@{
    ViewData["Title"] = "Wishlist";
}

<!-- Main Wrapper -->
<div class="main-wrapper">
    <!-- Breadcrumb -->
    <div class="breadcrumb-bar text-center">
        <div class="container">
            <div class="row">
                <div class="col-md-12 col-12">
                    <h2 class="breadcrumb-title mb-2">Wishlist</h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb justify-content-center mb-0">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Wishlist</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    <!-- /Breadcrumb -->

    <div class="content">
        <div class="container">
            <div class="row">
                @await Html.PartialAsync("_StudentSidebar")
                <div class="col-lg-9">
                    <div class="page-title d-flex align-items-center justify-content-between">
                        <h5>Wishlist</h5>
                    </div>
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <p class="text-muted">Your wishlist is empty.</p>
                            <a asp-controller="Course" asp-action="List" class="btn btn-primary">Browse Courses</a>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            @foreach (var item in Model)
                            {
                                var course = item.Course;
                                var avgRating = course.Reviews?.Any() == true
                                    ? course.Reviews.Average(r => r.Rating)
                                    : 0;
                                var reviewCount = course.Reviews?.Count ?? 0;
                                var imageUrl = string.IsNullOrEmpty(course.ImagePath) || !course.ImagePath.StartsWith("/")
                                    ? "/img/default.jpg"
                                    : course.ImagePath;
                                <div class="col-xl-4 col-md-6 d-flex">
                                    <div class="course-item course-item-three w-100">
                                        <div class="position-relative overflow-hidden rounded-3 mb-3">
                                            <a asp-controller="Course" asp-action="Detail" asp-route-id="@course.Id">
                                                <img class="img-fluid rounded-3" src="@imageUrl" alt="@course.Title"
                                                     onerror="this.onerror=null; this.src='/img/default.jpg';">
                                            </a>
                                            <div class="position-absolute start-0 top-0 d-flex align-items-start w-100 z-index-2 p-2">
                                                <button type="button" class="btn btn-sm btn-outline-danger remove-wishlist-btn"
                                                        data-course-id="@course.Id" title="Remove from Wishlist">
                                                    <i class="isax isax-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="d-flex flex-wrap align-items-center justify-content-between">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar avatar-sm rounded-circle">
                                                    @if (!string.IsNullOrEmpty(course.Instructor?.AvatarPath))
                                                    {
                                                        <img class="img-fluid rounded-circle" src="@course.Instructor.AvatarPath" alt="">
                                                    }
                                                    else
                                                    {
                                                        <span class="d-flex align-items-center justify-content-center bg-secondary text-white rounded-circle" style="width:30px;height:30px;font-size:10px;">
                                                            @(course.Instructor?.FirstName?.FirstOrDefault())@(course.Instructor?.LastName?.FirstOrDefault())
                                                        </span>
                                                    }
                                                </div>
                                                <p class="fs-14 ms-2"><a href="#">@(course.Instructor?.FirstName ?? "Instructor") @(course.Instructor?.LastName ?? "")</a></p>
                                            </div>
                                            <span class="tag-btn">@course.Category?.Name</span>
                                        </div>
                                        <h6 class="mt-3 mb-2"><a asp-controller="Course" asp-action="Detail" asp-route-id="@course.Id">@course.Title</a></h6>
                                        <div class="d-flex align-items-center">
                                            <i class="fa-solid fa-star text-warning fs-12"></i>
                                            <p class="fs-14 ms-1">@avgRating.ToString("0.0") (@reviewCount Reviews)</p>
                                        </div>
                                        <div class="d-flex justify-content-between mt-3 align-items-center">
                                            <h5 class="text-secondary">
                                                @if (course.Price == 0)
                                                {
                                                    <span>FREE</span>
                                                }
                                                else
                                                {

                                                    <span>$@course.Price</span>
                                                }
                                            </h5>
                                            <a asp-controller="Course" asp-action="Detail" asp-route-id="@course.Id" class="btn btn-dark btn-sm d-inline-flex align-items-center">
                                                View Course<i class="fs-8 fas fa-angle-right ms-2"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Удаление из Wishlist
        $(document).on('click', '.remove-wishlist-btn', function () {
            var courseId = $(this).data('course-id');
            var card = $(this).closest('.col-xl-4');
            $.post('/Student/RemoveFromWishlist', { courseId: courseId }, function (response) {
                if (response.success) {
                    card.fadeOut(300, function () { $(this).remove(); });
                    // Можно обновить счётчик в хедере, если понадобится
                }
            });
        });
    </script>
}
                <h2>Course Categories</h2>
                <p>Explore our top categories to find the perfect courses for your learning journey</p>
            </div>
            <div class="home-five-course aos">
                @if (categories != null)
                {
                    foreach (var cat in categories)
                    {
                        <div class="categories-item categories-item-six" data-aos="fade-down">
                            <div class="categories-icon">
                                <div class="icon-bg">
                                    <a asp-controller="Course" asp-action="CategoryCourses" asp-route-id="@cat.Id">
                                        <img src="@(string.IsNullOrEmpty(cat.ImagePath) ? "/img/default.jpg" : cat.ImagePath)" alt="@cat.Name" onerror="this.onerror=null;this.src='/img/default.jpg';">
                                    </a>
                                </div>
                            </div>
                            <h3 class="title"><a asp-controller="Course" asp-action="CategoryCourses" asp-route-id="@cat.Id">@cat.Name</a></h3>
                            <p>@(cat.Courses?.Count ?? 0) Courses</p>
                            <a asp-controller="Course" asp-action="CategoryCourses" asp-route-id="@cat.Id" class="view-icon"><i class="fas fa-chevron-right"></i></a>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
    <!-- /Course Categories Five -->
    <!-- Counter Five -->
    <section class="counter-section-five">
        <div class="container">
            <div class="row align-items-center text-center justify-content-between">
                <div class="col-lg-4 col-md-4 col-sm-12" data-aos="fade-down">
                    <div class="count-five">
                        <div class="count-content-five course-count ms-0">
                            <h4><span class="counterUp">@instructorCount</span></h4>
                            <p class="mb-0">Expert Tutors</p>
                        </div>
                    </div>
                </div>

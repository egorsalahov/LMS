                        <div class="count-content-five course-count ms-0">
                            <h4><span class="counterUp">@studentCount</span>+</h4>
                            <p class="mb-0">Online students</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-4 col-sm-12" data-aos="fade-down">
                    <div class="count-five count-five-last count-five-0">
                        <div class="count-content-five course-count ms-0">
                            <h4><span class="counterUp">@courseCount</span></h4>
                            <p class="mb-0">Online Courses</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- /Counter Five -->
    <!-- Popular Courses -->
    <section class="featured-section-five">
        <div class="container">
            <div class="section-header section-header-six text-center" data-aos="fade-down">
                <h2>Popular Courses</h2>
                <p>Discover our featured courses, specially curated to help you gain in-demand skills</p>
            </div>
            <div class="row">
                @if (popularCourses != null)
                {
                    foreach (var course in popularCourses)
                    {
                        var imageUrl = string.IsNullOrEmpty(course.ImagePath) || !course.ImagePath.StartsWith("/") ? "/img/default.jpg" : course.ImagePath;
                        var avgRating = course.Reviews?.Any() == true ? course.Reviews.Average(r => r.Rating) : 0;
                        var reviewCount = course.Reviews?.Count ?? 0;
                        <div class="col-lg-4 col-md-6 d-flex">
                            <div class="course-item course-item-three mx-0 flex-fill aos" data-aos="fade-up">
                                <div class="course-img">
                                    <a asp-controller="Course" asp-action="Detail" asp-route-id="@course.Id">
                                        <img class="img-fluid" alt="@course.Title" src="@imageUrl" onerror="this.onerror=null;this.src='/img/default.jpg';">
                                    </a>
                                    <div class="price">
                                        @if (course.Price == 0)
                                        {
                                            <h3>FREE</h3>
                                        }
                                        else
                                        {
                                            <h3>$@course.Price @if (course.OldPrice.HasValue) {
                                                <span>$@course.OldPrice</span>
                                            }
                                        </h3>
                                    }
                                </div>
                            </div>
                            <div class="course-content">
                                <div class="course-user">
                                    <div class="course-user-img">
                                        <a href="#"><img src="@(string.IsNullOrEmpty(course.Instructor?.AvatarPath) ? "/img/default.jpg" : course.Instructor.AvatarPath)" alt="img" class="img-fluid" onerror="this.onerror=null;this.src='/img/default.jpg';"></a>
                                        <div class="course-name">
                                            <h4><a href="#">@(course.Instructor?.FirstName ?? "Instructor") @(course.Instructor?.LastName ?? "")</a></h4>
                                            <p>Instructor</p>
                                        </div>
                                    </div>
                                    <a href="#" class="fav-icon"><i class="fa-regular fa-heart"></i></a>
                                </div>
                                <h3 class="title"><a asp-controller="Course" asp-action="Detail" asp-route-id="@course.Id">@course.Title</a></h3>
                                <div class="course-info d-flex align-items-center">
                                    <div class="course-lesson d-flex align-items-center">
                                        <img src="~/img/icons/icon-3.svg" alt="Img">
                                        <p>@(course.Sections?.Sum(s => s.Lessons?.Count) ?? 0)+ Lesson</p>
                                    </div>
                                    <div class="course-time d-flex align-items-center">
                                        <img src="~/img/icons/icon-4.svg" alt="Img">
                                        <p>@(course.Duration.TotalHours > 0 ? $"{course.Duration.Hours}hr {course.Duration.Minutes}min" : "N/A")</p>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="rating m-0">
                                        <i class="fas fa-star filled"></i><i class="fas fa-star filled"></i><i class="fas fa-star filled"></i><i class="fas fa-star filled"></i><i class="fas fa-star"></i>
                                        <span class="d-inline-block average-rating"><span>@avgRating.ToString("0.0")</span> (@reviewCount)</span>
                                    </div>
                                    <a asp-controller="Course" asp-action="Detail" asp-route-id="@course.Id" class="btn btn-primary btn-xl d-inline-flex align-items-center flex-shrink-0">
                                        View Course<i class="isax isax-arrow-right-3 ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
        <div class="text-center">
            <a asp-controller="Course" asp-action="List" class="btn btn-xl btn-primary mt-2" data-aos="fade-up">See More Courses</a>
        </div>
    </div>
</section>
<!-- /Popular Courses -->

@{
    var categories = ViewBag.Categories as List<Category>;
    var popularCourses = ViewBag.PopularCourses as List<Course>;
    int instructorCount = ViewBag.InstructorCount ?? 0;
    int studentCount = ViewBag.StudentCount ?? 0;
    int courseCount = ViewBag.CourseCount ?? 0;
}

<!-- Main Wrapper -->
<div class="main-wrapper index-six">

    <div class="home-six">
        <!-- Home Banner unchanged -->
        <section class="home-slide-five">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-xl-5 col-lg-6 col-12">
                        <div class="home-slide-five-face" data-aos="fade-down">
                            <div class="home-slide-five-text">
                                <span class="text-warning d-inline-flex fw-semibold text-uppercase mb-3">The Leader in Online Learning</span>
                                <h1 class="text-white mb-4">Engaging & Accessible Online Courses For All</h1>
                                <p class="text-white fs-lg text-center text-md-start pb-2 pb-md-3 mb-4">Trusted by over 15K Users worldwide since 2022</p>
                            </div>
                            <!-- banner Seach Category -->
                            <div class="banner-content-five">
                                <div class="form-inner-five">
                                    <div class="input-group position-relative">
                                        <span class="drop-detail-five">
                                            <select class="form-select select" id="searchCategory">
                                                <option value="">All Categories</option>
                                                @if (categories != null)
                                                {
                                                    foreach (var cat in categories)
                                                    {
                                                        <option value="@cat.Id">@cat.Name</option>
                                                    }
                                                }
                                            </select>
                                        </span>
                                        <input type="text" class="form-control" placeholder="Search for Courses..." id="searchInput" autocomplete="off">
                                        <button class="btn btn-primary sub-btn" type="button" id="searchBtn">
                                            <span><i class="fa-solid fa-magnifying-glass"></i></span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <!-- /banner Seach Category -->
                        </div>
                    </div>
                    <div class="col-xl-7 col-lg-6 col-12">
                        <div class="banner-six-img">
                            <div class="row">
                                <div class="col-lg-6 align-self-end">
                                    <div class="ban-img-1" data-aos="fade-up"><img src="~/img/hero/hero-7.png" alt="img"></div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="ban-img-2" data-aos="fade-down">
                                        <img class="ban-shape2" data-aos="fade-down" data-aos-delay="250" src="~/img/shapes/dot-group.png" alt="img">
                                        <img class="ban-shape3" data-aos="fade-down" data-aos-delay="300" src="~/img/banner/ban-shape-2.svg" alt="img">
                                        <img class="ban-shape4" data-aos="fade-down" data-aos-delay="350" src="~/img/banner/ban-shape-3.svg" alt="img">
                                        <img src="~/img/hero/hero-8.png" alt="img">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="vector-shapes-five d-none d-lg-flex"><img src="~/img/bg/banner-vector.svg" alt="Img"></div>
            </div>
        </section>
        <!-- /Home Banner -->
    </div>

    <!-- Leading Companies (unchanged) -->

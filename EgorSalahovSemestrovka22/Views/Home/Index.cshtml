@section Scripts {
    <script>
        // Создаём контейнер в body для корректного z-index
        $('body').append('<div class="search-results-dropdown" id="searchResults" style="display:none;"></div>');

        var searchTimeout;

        $('#searchInput').on('keyup', function () {
            var query = $(this).val().trim();
            var categoryId = $('#searchCategory').val();

            // Позиционируем выпадашку
            var offset = $(this).offset();
            var width = $(this).outerWidth();
            $('#searchResults').css({
                top: offset.top + $(this).outerHeight() + 2,
                left: offset.left,
                width: width,
                position: 'fixed'
            });

            clearTimeout(searchTimeout);

            if (query.length < 2) {
                $('#searchResults').hide().empty();
                return;
            }

            searchTimeout = setTimeout(function () {
                $.get('/Course/Search', { query: query, categoryId: categoryId }, function (data) {
                    var html = '';
                    if (data.length === 0) {
                        html = '<div class="search-no-results">No courses found</div>';
                    } else {
                        data.forEach(function (course) {
                            html += '<div class="search-result-item" onclick="window.location.href=\'/Course/Detail/' + course.id + '\'">';
                            html += '<img src="' + course.imagePath + '" alt="" onerror="this.src=\'/img/default.jpg\';">';
                            html += '<div class="search-result-info">';
                            html += '<div class="search-result-title">' + course.title + '</div>';
                            html += '<div class="search-result-meta">' + course.instructor + ' · $' + course.price + '</div>';
                            html += '</div>';
                            html += '<i class="fas fa-chevron-right text-muted"></i>';
                            html += '</div>';
                        });
                    }
                    $('#searchResults').html(html).show();
                });
            }, 300);
        });

        // Перепозиционирование при скролле и ресайзе
        $(window).on('scroll resize', function () {
            if ($('#searchResults').is(':visible')) {
                var offset = $('#searchInput').offset();
                var width = $('#searchInput').outerWidth();
                $('#searchResults').css({
                    top: offset.top + $('#searchInput').outerHeight() + 2,
                    left: offset.left,
                    width: width
                });
            }
        });

        $('#searchBtn').click(function () {
            var query = $('#searchInput').val().trim();
            var categoryId = $('#searchCategory').val();
            if (query.length >= 2) {
                var url = '/Course/List?search=' + encodeURIComponent(query);
                if (categoryId && categoryId !== '') {
                    url += '&categoryId=' + categoryId;
                }
                window.location.href = url;
            }
        });

        $('#searchInput').on('keypress', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                $('#searchBtn').click();
            }
        });

        $(document).on('click', function (e) {
            if (!$(e.target).closest('#searchInput').length && !$(e.target).closest('#searchResults').length) {
                $('#searchResults').hide();
            }
        });

        $('#searchInput').on('focus', function () {
            var query = $(this).val().trim();
            if (query.length >= 2) {
                $(this).trigger('keyup');
            }
        });
    </script>
}

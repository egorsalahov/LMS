@model CreateCourseViewModel
@{
    ViewData["Title"] = "Add New Course";
    var categories = ViewBag.Categories as SelectList;
}

<!-- Breadcrumb -->
<div class="breadcrumb-bar text-center">
    <div class="container">
        <div class="row">
            <div class="col-md-12 col-12">
                <h2 class="breadcrumb-title mb-2">Add New Course</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-center mb-0">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Add New Course</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
<!-- /Breadcrumb -->

<form asp-action="AddNewCourse" method="post" enctype="multipart/form-data" id="courseWizardForm">
    @Html.AntiForgeryToken()

    <!-- Course add -->
    <div class="content">
        <div class="container">
            <div class="row">
                <div class="col-lg-10 mx-auto">
                    <div class="add-course-item">
                        <div class="wizard">
                            <ul class="form-wizard-steps" id="progressbar2">
                                <li class="progress-active">
                                    <div class="profile-step">
                                        <span class="dot-active mb-2">
                                            <span class="number">01</span>
                                            <span class="tickmark"><i class="fa-solid fa-check"></i></span>
                                        </span>
                                        <div class="step-section"><p>Course Information</p></div>
                                    </div>
                                </li>
                                <li>
                                    <div class="profile-step">
                                        <span class="dot-active mb-2">
                                            <span class="number">02</span>
                                            <span class="tickmark"><i class="fa-solid fa-check"></i></span>
                                        </span>
                                        <div class="step-section"><p>Course Media</p></div>
                                    </div>
                                </li>
                                <li>
                                    <div class="profile-step">
                                        <span class="dot-active mb-2">
                                            <span class="number">03</span>
                                            <span class="tickmark"><i class="fa-solid fa-check"></i></span>
                                        </span>
                                        <div class="step-section"><p>Curriculum</p></div>
                                    </div>
                                </li>
                                <li>
                                    <div class="profile-step">
                                        <span class="dot-active mb-2">
                                            <span class="number">04</span>
                                            <span class="tickmark"><i class="fa-solid fa-check"></i></span>
                                        </span>
                                        <div class="step-section"><p>Pricing</p></div>
                                    </div>
                                </li>
                            </ul>
                        </div>
                        <div class="initialization-form-set">

                            <!-- STEP 1: Course Information -->
                            <fieldset class="form-inner wizard-form-card" id="first">
                                <div class="title"><h5>Basic Information</h5></div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="input-block">
                                            <label class="form-label">Course Title<span class="text-danger ms-1">*</span></label>
                                            <input asp-for="Title" class="form-control" />
                                            <span asp-validation-for="Title" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="input-block">
                                            <label class="form-label">Course Category<span class="text-danger ms-1">*</span></label>
                                            <select asp-for="CategoryId" class="select form-control" asp-items="categories">
                                                <option value="">Select</option>
                                            </select>
                                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="input-block">
                                            <label class="form-label">Course Level<span class="text-danger ms-1">*</span></label>
                                            <select asp-for="LevelForStudent" class="select form-control" asp-items="Html.GetEnumSelectList<Level>()">
                                                <option value="">Select</option>
                                            </select>
                                            <span asp-validation-for="LevelForStudent" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="input-block">
                                            <label class="form-label">Short Description<span class="text-danger ms-1">*</span></label>
                                            <input asp-for="ShortDescription" class="form-control" />
                                            <span asp-validation-for="ShortDescription" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="input-block">
                                            <label class="form-label">Course Description<span class="text-danger ms-1">*</span></label>
                                            <textarea asp-for="FullDescription" class="form-control summernote" rows="5"></textarea>
                                            <span asp-validation-for="FullDescription" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="input-block">
                                            <label class="form-label">Course Features</label>
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="form-check">
                                                        <input asp-for="HasLifetimeAccess" class="form-check-input" type="checkbox" checked />
                                                        <label asp-for="HasLifetimeAccess" class="form-check-label">Lifetime Access</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-check">
                                                        <input asp-for="HasMobileAccess" class="form-check-input" type="checkbox" checked />
                                                        <label asp-for="HasMobileAccess" class="form-check-label">Mobile Access</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-check">
                                                        <input asp-for="HasAssignments" class="form-check-input" type="checkbox" />
                                                        <label asp-for="HasAssignments" class="form-check-label">Assignments</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-check">
                                                        <input asp-for="HasCommunityAccess" class="form-check-input" type="checkbox" />
                                                        <label asp-for="HasCommunityAccess" class="form-check-label">Community Access</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-check">
                                                        <input asp-for="HasDownloadableResources" class="form-check-input" type="checkbox" />
                                                        <label asp-for="HasDownloadableResources" class="form-check-label">Downloadable Resources</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-check">
                                                        <input asp-for="HasSubtitles" class="form-check-input" type="checkbox" />
                                                        <label asp-for="HasSubtitles" class="form-check-label">Subtitles</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="add-form-btn widget-next-btn submit-btn d-flex justify-content-end mb-0">
                                    <div class="btn-left">
                                        <a href="javascript:void(0);" class="btn main-btn next_btns">Next <i class="isax isax-arrow-right-3 ms-1"></i></a>
                                    </div>
                                </div>
                            </fieldset>

                            <!-- STEP 2: Course Media -->
                            <fieldset class="form-inner wizard-form-card">
                                <div class="title"><h5>Course Media</h5></div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="input-block">
                                            <div class="row align-items-center">
                                                <div class="col-md-12">
                                                    <label class="form-label">Course Thumbnail</label>
                                                </div>
                                                <div class="col-md-10">
                                                    <input type="text" class="form-control" placeholder="No File Selected" id="file-name-display" readonly>
                                                </div>
                                                <div class="col-md-2 d-grid">
                                                    <label for="file-upload" class="file-upload-btn text-center">Upload File</label>
                                                    <input type="file" asp-for="ImageFile" id="file-upload" accept="image/*" style="display:none;">
                                                </div>
                                            </div>
                                            <span id="image-error" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="upload-img-section d-flex align-items-center justify-content-center" id="upload-img-section">
                                            <div class="upload-content">
                                                <span class="d-flex align-items-center justify-content-center mb-1">
                                                    <i class="isax isax-image5 text-secondary fs-24 text-center"></i>
                                                </span>
                                                <p class="text-center fw-medium mb-1">Upload Image</p>
                                                <span class="text-center">JPEG, PNG, GIF, and WebP formats, up to 2 MB</span>
                                            </div>
                                        </div>
                                        <hr class="mt-4 mb-4">
                                    </div>
                                </div>
                                <div class="add-form-btn widget-next-btn submit-btn">
                                    <div class="btn-left">
                                        <a href="javascript:void(0);" class="btn btn-light main-btn prev_btns d-flex align-items-center"><i class="isax isax-arrow-left-2 me-1"></i>Prev</a>
                                    </div>
                                    <div class="btn-left">
                                        <a href="javascript:void(0);" class="btn btn-secondary main-btn next_btns d-flex align-items-center">Next <i class="isax isax-arrow-right-3 ms-1"></i></a>
                                    </div>
                                </div>
                            </fieldset>

                            <!-- STEP 3: Curriculum -->
                            <fieldset class="form-inner wizard-form-card">
                                <div class="title">
                                    <div class="row align-items-center row-gap-2">
                                        <div class="col-md-6"><h5 class="mb-0">Curriculum</h5></div>
                                        <div class="col-md-6 text-md-end">
                                            <button type="button" class="btn add-edit-btn d-inline-flex align-items-center" data-bs-toggle="modal" data-bs-target="#add-topic">
                                                <i class="isax isax-add-circle5 me-1"></i> Add New Topic
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <div class="accordions-items-seperate" id="curriculum-accordion"></div>
                                </div>
                                <div class="add-form-btn widget-next-btn submit-btn">
                                    <div class="btn-left">
                                        <a href="javascript:void(0);" class="btn btn-light main-btn prev_btns"><i class="isax isax-arrow-left-2 me-1"></i>Prev</a>
                                    </div>
                                    <div class="btn-left">
                                        <a href="javascript:void(0);" class="btn btn-secondary main-btn next_btns">Next <i class="isax isax-arrow-right-3 ms-1"></i></a>
                                    </div>
                                </div>
                            </fieldset>

                            <!-- STEP 4: Pricing -->
                            <fieldset class="form-inner wizard-form-card">
                                <div>
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="form-check form-check-md d-flex align-items-center">
                                            <input asp-for="IsFree" class="form-check-input" type="checkbox" id="isFreeCheck" />
                                            <label class="form-check-label ms-2" for="isFreeCheck">Check if this is a free course</label>
                                        </div>
                                    </div>
                                    <div class="input-block mb-2" id="priceBlock">
                                        <label class="form-label">Course Price ($)<span class="text-danger ms-1">*</span></label>
                                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                                        <span asp-validation-for="Price" class="text-danger"></span>
                                    </div>
                                    <div class="input-block" id="oldPriceBlock">
                                        <label class="form-label">Discount Price ($)</label>
                                        <input asp-for="OldPrice" class="form-control mb-1" type="number" step="0.01" min="0" />
                                        <span asp-validation-for="OldPrice" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="add-form-btn widget-next-btn submit-btn">
                                    <div class="btn-left">
                                        <a href="javascript:void(0);" class="btn btn-light main-btn prev_btns"><i class="isax isax-arrow-left-2 me-1"></i>Prev</a>
                                    </div>
                                    <div class="btn-left">
                                        <button type="submit" class="btn btn-secondary main-btn" id="submitCourseBtn">Submit Course</button>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="hidden-sections-container"></div>
</form>

<!-- ========== МОДАЛЬНЫЕ ОКНА ========== -->
<!-- Add Topic Modal -->
<div class="modal fade" id="add-topic" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Topic Name</h5>
                <button type="button" class="btn-close custom-btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="isax isax-close-circle5"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="input-block">
                    <label class="form-label">Section Title<span class="text-danger ms-1">*</span></label>
                    <input type="text" class="form-control" id="topic-name-input">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn me-2 btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-secondary" id="btn-add-topic">Add Section</button>
            </div>
        </div>
    </div>
</div>

<!-- Add Lesson Modal -->
<div class="modal fade" id="add-lesson" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5>New Lesson</h5>
                <button type="button" class="btn-close custom-btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="isax isax-close-circle5"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="input-block mb-4">
                    <label class="form-label">Lesson Title<span class="text-danger ms-1">*</span></label>
                    <input type="text" class="form-control" id="lesson-name-input">
                </div>
                <div class="input-block mb-4">
                    <label class="form-label">Upload Video</label>
                    <input type="file" class="form-control" id="lesson-video-input" accept="video/*">
                    <span class="text-danger fs-12" id="video-error"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn me-2 btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-secondary" id="btn-add-lesson">Add Lesson</button>
            </div>
        </div>
    </div>
</div>

<!-- Validation Errors Modal -->
<div class="modal fade" id="validationErrorsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Validation Errors</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Please fix the following errors:</p>
                <ul id="validationErrorsList" class="text-danger mb-0"></ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">OK, I'll fix</button>
            </div>
        </div>
    </div>
</div>

<!-- ========== СКРИПТЫ ========== -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-bs4.min.js"></script>
    <script>
        $(function () {
        // ========== SUMMERNOTE ==========
        $('.summernote').summernote({
        height: 200,
        toolbar: [
        ['style', ['bold', 'italic', 'underline', 'clear']],
        ['fontsize', ['fontsize']],
        ['color', ['color']],
        ['para', ['ul', 'ol', 'paragraph']],
        ['insert', ['link']]
        ]
        });

        // ========== WIZARD NAVIGATION ==========
        $('.next_btns').click(function () {
        $(this).closest('fieldset').hide().next('fieldset').show();
        updateProgressBar();
        });

        $('.prev_btns').click(function () {
        $(this).closest('fieldset').hide().prev('fieldset').show();
        updateProgressBar();
        });

        function updateProgressBar() {
        var currentStep = $('fieldset:visible').index('fieldset');
        $('#progressbar2 li').removeClass('progress-active');
        $('#progressbar2 li:lt(' + currentStep + ')').addClass('progress-active');
        }

        // ========== PRICE TOGGLE ==========
        $('#isFreeCheck').on('change', function () {
        if ($(this).is(':checked')) {
        $('#priceBlock, #oldPriceBlock').slideUp(200);
        $('[name="Price"]').val(0);
        $('[name="OldPrice"]').val('');
        } else {
        $('#priceBlock, #oldPriceBlock').slideDown(200);
        if (!$('[name="Price"]').val() || $('[name="Price"]').val() == '0') {
        $('[name="Price"]').val('');
        }
        }
        });

        // ========== IMAGE UPLOAD PREVIEW ==========
        $('#file-upload').on('change', function () {
        var file = this.files[0];
        $('#image-error').text('');
        if (!file) {
        $('#file-name-display').val('No File Selected');
        return;
        }
        var allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
        if ($.inArray(file.type, allowedTypes) === -1) {
        $('#image-error').text('Only JPEG, PNG, GIF, WebP are allowed.');
        $(this).val('');
        $('#file-name-display').val('No File Selected');
        return;
        }
        if (file.size > 2 * 1024 * 1024) {
        $('#image-error').text('File size must be up to 2 MB.');
        $(this).val('');
        $('#file-name-display').val('No File Selected');
        return;
        }
        $('#file-name-display').val(file.name);

        // Preview image
        var reader = new FileReader();
        reader.onload = function (e) {
        $('#upload-img-section').html('<img src="' + e.target.result + '" style="max-width:100%;max-height:200px;border-radius:8px;">');
        };
        reader.readAsDataURL(file);
        });

        // ========== CURRICULUM LOGIC ==========
        let sectionIndex = 0;
        let currentSectionIndex = -1;

        $(document).on('click', '.add-lesson-btn', function () {
        currentSectionIndex = $(this).data('section-index');
        $('#lesson-name-input').val('');
        $('#lesson-video-input').val('');
        $('#video-error').text('');
        $('#add-lesson').modal('show');
        });

        $('#btn-add-topic').click(function () {
        const title = $('#topic-name-input').val().trim();
        if (!title) { alert('Enter section title'); return; }

        const sectionHtml = `
        <div class="accordion-item" data-section-index="${sectionIndex}">
        <h2 class="accordion-header">
        <a href="javascript:void(0);" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#section-${sectionIndex}">
        <span class="d-flex align-items-center mb-0"><i class="isax isax-menu-15 me-2"></i>${title}</span>
        </a>
        </h2>
        <div id="section-${sectionIndex}" class="accordion-collapse collapse show">
        <div class="accordion-body">
        <div class="lessons-container"></div>
        <button type="button" class="btn btn-sm btn-primary add-lesson-btn mt-2" data-section-index="${sectionIndex}">
        <i class="isax isax-add-circle5 me-1"></i> Add Lesson
        </button>
        <button type="button" class="btn btn-sm btn-outline-danger remove-section-btn mt-2 ms-1">
        <i class="isax isax-trash"></i> Delete Section
        </button>
        </div>
        </div>
        </div>`;

        $('#curriculum-accordion').append(sectionHtml);
        $('#hidden-sections-container').append(
        `<input type="hidden" name="Sections[${sectionIndex}].Title" value="${title}" />`
        );
        $('#topic-name-input').val('');
        $('#add-topic').modal('hide');
        sectionIndex++;
        });

        $('#btn-add-lesson').click(function () {
        const title = $('#lesson-name-input').val().trim();
        const videoFile = $('#lesson-video-input')[0].files[0];

        if (!title) { alert('Enter lesson title'); return; }
        if (currentSectionIndex < 0) { alert('Select a topic first'); return; }

        if (videoFile) {
        var allowedVideoTypes = ['video/mp4', 'video/webm', 'video/ogg'];
        if ($.inArray(videoFile.type, allowedVideoTypes) === -1) {
        $('#video-error').text('Only MP4, WebM, OGG are allowed.');
        return;
        }
        if (videoFile.size > 200 * 1024 * 1024) {
        $('#video-error').text('File size must be up to 200 MB.');
        return;
        }
        }
        $('#video-error').text('');

        const sectionEl = $(`#curriculum-accordion [data-section-index="${currentSectionIndex}"]`);
        const lessonsContainer = sectionEl.find('.lessons-container');
        const lessonIndex = lessonsContainer.children('.lesson-item').length;
        const fileName = videoFile ? videoFile.name : 'No video';

        const lessonHtml = `
        <div class="lesson-item d-flex align-items-center justify-content-between bg-white p-2 border rounded-3 mb-2">
        <div class="d-flex align-items-center">
        <span><i class="isax isax-play-circle5 text-success fs-24 me-1"></i></span>
        <div>
        <p class="fw-medium text-gray-5 mb-0">${title}</p>
        <small class="text-muted">${fileName}</small>
        </div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-danger remove-lesson-btn">
        <i class="isax isax-trash"></i>
        </button>
        </div>`;

        lessonsContainer.append(lessonHtml);

        $('#hidden-sections-container').append(
        `<input type="hidden" name="Sections[${currentSectionIndex}].Lessons[${lessonIndex}].Title" value="${title}" />`
        );

        if (videoFile) {
        var fileInput = $('#lesson-video-input').clone()
        .attr('name', `Sections[${currentSectionIndex}].Lessons[${lessonIndex}].VideoFile`)
        .attr('id', '')
        .hide();
        $('#hidden-sections-container').append(fileInput);
        }

        $('#lesson-name-input').val('');
        $('#lesson-video-input').val('');
        $('#add-lesson').modal('hide');
        });

        $(document).on('click', '.remove-section-btn', function () {
        const idx = $(this).closest('.accordion-item').data('section-index');
        $(this).closest('.accordion-item').remove();
        $(`input[name^="Sections[${idx}]"]`).remove();
        reindexSections();
        });

        $(document).on('click', '.remove-lesson-btn', function () {
        const sectionEl = $(this).closest('.accordion-item');
        const sectionIdx = sectionEl.data('section-index');
        $(this).closest('.lesson-item').remove();
        reindexLessons(sectionIdx, sectionEl.find('.lessons-container'));
        });

        function reindexSections() {
        $('#curriculum-accordion .accordion-item').each(function (i) {
        $(this).attr('data-section-index', i);
        $(this).find('.add-lesson-btn').attr('data-section-index', i);
        });
        }

        function reindexLessons(sectionIdx, container) {
        $(`input[name^="Sections[${sectionIdx}].Lessons"]`).remove();
        container.children('.lesson-item').each(function (i) {
        const title = $(this).find('p.fw-medium').text().trim();
        $('#hidden-sections-container').append(
        `<input type="hidden" name="Sections[${sectionIdx}].Lessons[${i}].Title" value="${title}" />`
        );
        });
        }

        // ========== SERVER-SIDE ERRORS (если вернулись после POST) ==========
        @if (ViewBag.ValidationErrors != null)
        {
            <text>
                var serverErrors = @Html.Raw(Json.Serialize(ViewBag.ValidationErrors));
                serverErrors.forEach(function (err) {
                $('#validationErrorsList').append('<li>' + err + '</li>');
                });
                $('#validationErrorsModal').modal('show');
                // Показать первый шаг с ошибкой
                $('fieldset:first').show().siblings('fieldset').hide();
            </text>
        }

        // ========== CLIENT-SIDE VALIDATION BEFORE SUBMIT ==========
        $('#courseWizardForm').on('submit', function (e) {
        var errors = [];
        $('#validationErrorsList').empty();
        $('.text-danger').text('');
        $('#image-error').text('');

        // STEP 1
        var title = $('[name="Title"]').val().trim();
        if (!title) errors.push('Course Title is required.');

        var categoryId = $('[name="CategoryId"]').val();
        if (!categoryId || categoryId === '') errors.push('Course Category is required.');

        var level = $('[name="LevelForStudent"]').val();
        if (!level || level === '') errors.push('Course Level is required.');

        var shortDesc = $('[name="ShortDescription"]').val().trim();
        if (!shortDesc) errors.push('Short Description is required.');

        var fullDesc = $('[name="FullDescription"]').val().trim();
        if (!fullDesc || fullDesc === '<p><br></p>' || fullDesc === '') {
        errors.push('Course Description is required.');
        }

        // STEP 4
        var isFree = $('#isFreeCheck').is(':checked');
        if (!isFree) {
        var price = parseFloat($('[name="Price"]').val());
        if (isNaN(price) || price < 0) {
        errors.push('Course Price must be a valid non-negative number.');
        }
        }

        if (errors.length > 0) {
        e.preventDefault();
        errors.forEach(function (err) {
        $('#validationErrorsList').append('<li>' + err + '</li>');
        });
        $('#validationErrorsModal').modal('show');
        return false;
        }

        // Если всё ок — показываем loading на кнопке
        $('#submitCourseBtn').prop('disabled', true)
        .html('<span class="spinner-border spinner-border-sm me-1"></span>Submitting...');
        });

        // ========== ИНИЦИАЛИЗАЦИЯ ==========
        // Показываем первый шаг
        $('fieldset:not(:first)').hide();
        updateProgressBar();

        // Если IsFree отмечен при загрузке — скрываем цену
        if ($('#isFreeCheck').is(':checked')) {
        $('#priceBlock, #oldPriceBlock').hide();
        }
        });
    </script>
}
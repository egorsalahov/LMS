<div class="instructor-profile">
	<div class="instructor-profile-bg">
		<img src="~/img/bg/card-bg-01.png" class="instructor-profile-bg-1" alt="">
	</div>
	<div class="row align-items-center row-gap-3">
		<div class="col-md-6">
			<div class="d-flex align-items-center">
				<h5 class="mb-1 text-white d-inline-flex align-items-center">
					@(ViewBag.InstructorName ?? "Instructor")
					<a asp-controller="Instructor" asp-action="MyProfile" class="link-light fs-16 ms-2">
						<i class="isax isax-edit-2"></i>
					</a>
				</h5>
			</div>
		</div>
		<div class="col-md-6">
			<div class="d-flex align-items-center flex-wrap gap-3 justify-content-md-end">
				<a asp-controller="Instructor" asp-action="AddNewCourse" class="btn btn-white rounded-pill">Add New Course</a>
			</div>
		</div>
	</div>
</div>
@model RegisterViewModel
@{
    Layout = "_LayoutAuth";
}

<!-- Main Wrapper -->
<div class="main-wrapper">
    <div class="login-content">
        <div class="row">
            <!-- Login Banner -->
            <div class="col-lg-6 login-bg d-none d-lg-flex">
                <div class="login-carousel">
                    <div>
                        <div class="login-carousel-section mb-3">
                            <div class="login-banner">
                                <img src="~/img/auth/auth-1.svg" class="img-fluid" alt="Logo">
                            </div>
                            <div class="mentor-course text-center">
                                <h3 class="mb-2">Welcome to <br>Dreams<span class="text-secondary">LMS</span> Courses.</h3>
                                <p>Platform designed to help organizations, educators, and learners manage, deliver, and track learning and training activities.</p>
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="login-carousel-section mb-3">
                            <div class="login-banner">
                                <img src="~/img/auth/auth-1.svg" class="img-fluid" alt="Logo">
                            </div>
                            <div class="mentor-course text-center">
                                <h3 class="mb-2">Welcome to <br>Dreams<span class="text-secondary">LMS</span> Courses.</h3>
                                <p>Platform designed to help organizations, educators, and learners manage, deliver, and track learning and training activities.</p>
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="login-carousel-section mb-3">
                            <div class="login-banner">
                                <img src="~/img/auth/auth-1.svg" class="img-fluid" alt="Logo">
                            </div>
                            <div class="mentor-course text-center">
                                <h3 class="mb-2">Welcome to <br>Dreams<span class="text-secondary">LMS</span> Courses.</h3>
                                <p>Platform designed to help organizations, educators, and learners manage, deliver, and track learning and training activities.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /Login Banner -->

            <div class="col-lg-6 login-wrap-bg">
                <!-- Login -->
                <div class="login-wrapper">
                    <div class="loginbox">
                        <div class="w-100">
                            <div class="d-flex align-items-center justify-content-between login-header">
                                <img src="~/img/logo.svg" class="img-fluid" alt="Logo">
                                <a href="index.html" class="link-1">Back to Home</a>
                            </div>
                            <h1 class="fs-32 fw-bold topic">Sign up</h1>
                            <form asp-controller="Account" asp-action="Register" method="post" class="mb-3 pb-3">
                                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                                <div class="mb-3 position-relative">
                                    <label asp-for="FullName" class="form-label">Full Name<span class="text-danger ms-1">*</span></label>
                                    <div class="position-relative">
                                        <input asp-for="FullName" class="form-control form-control-lg">
                                        <span><i class="isax isax-user input-icon text-gray-7 fs-14"></i></span>
                                    </div>
                                    <span asp-validation-for="FullName" class="text-danger fs-12"></span>
                                </div>

                                <div class="mb-3 position-relative">
                                    <label asp-for="Email" class="form-label">Email<span class="text-danger ms-1">*</span></label>
                                    <div class="position-relative">
                                        <input asp-for="Email" class="form-control form-control-lg">
                                        <span><i class="isax isax-sms input-icon text-gray-7 fs-14"></i></span>
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger fs-12"></span>
                                </div>

                                <div class="mb-3 position-relative">
                                    <label asp-for="Password" class="form-label">New Password<span class="text-danger"> *</span></label>
                                    <div class="position-relative" id="passwordInput">
                                        <input asp-for="Password" class="pass-inputs form-control form-control-lg">
                                        <span class="isax toggle-passwords isax-eye-slash text-gray-7 fs-14"></span>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger fs-12"></span>
                                </div>

                                <div class="mb-3 position-relative">
                                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password<span class="text-danger"> *</span></label>
                                    <div class="position-relative">
                                        <input asp-for="ConfirmPassword" class="pass-inputa form-control form-control-lg">
                                        <span class="isax toggle-passworda isax-eye-slash text-gray-7 fs-14"></span>
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger fs-12"></span>
                                </div>

                                <div class="d-flex align-items-center justify-content-between mb-4">
                                    <div class="remember-me d-flex align-items-center">
                                        <input asp-for="IsAgreed" class="form-check-input" type="checkbox">
                                        <label class="form-check-label mb-0 d-inline-flex remember-me fs-14" for="IsAgreed">
                                            I agree with Terms of Service and Privacy Policy
                                        </label>
                                    </div>
                                </div>

                                <div class="d-grid">
                                    <button class="btn btn-secondary btn-lg" type="submit">Sign Up <i class="isax isax-arrow-right-3 ms-1"></i></button>
                                </div>
                            </form>

                            <div class="d-flex align-items-center justify-content-center or fs-14 mb-3">
                                Or
                            </div>

                            <div class="d-flex align-items-center justify-content-center mb-3">
                                <a href="javascript:void(0);" class="btn btn-light me-2"><img src="~/img/icons/google.svg" alt="img" class="me-2">Google</a>
                                <a href="javascript:void(0);" class="btn btn-light"><img src="~/img/icons/facebook.svg" alt="img" class="me-2">Facebook</a>
                            </div>

                            <div class="fs-14 fw-normal d-flex align-items-center justify-content-center">
                                Already you have an account?<a asp-controller="Account" asp-action="SignIn" class="link-2 ms-1"> Login</a>
                            </div>

                            <!-- /Login -->

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /Main Wrapper -->
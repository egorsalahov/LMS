@{
    ViewData["Title"] = "Course List";
    var categories = ViewBag.Categories as IEnumerable<dynamic>;
}

<div class="main-wrapper">
    <div class="breadcrumb-bar text-center">
        <div class="container">
            <div class="row">
                <div class="col-md-12 col-12">
                    <h2 class="breadcrumb-title mb-2">Course List</h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb justify-content-center mb-0">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Course List</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <section class="course-content course-list-content">
        <div class="container">
            <div class="row align-items-baseline">
                <div class="col-lg-3 theiaStickySidebar">
                    <div class="filter-clear">
                        <div class="clear-filter mb-4 pb-lg-2 d-flex align-items-center justify-content-between">
                            <h5><i class="feather-filter me-2"></i>Filters</h5>
                        </div>
                        <div class="accordion accordion-customicon1 accordions-items-seperate" id="filterAccordion">
                            <!-- Categories -->
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingCategory">
                                    <a href="#" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#collapseCategory">Categories <i class="fa-solid fa-chevron-down"></i></a>
                                </h2>
                                <div id="collapseCategory" class="accordion-collapse collapse show" data-bs-parent="#filterAccordion">
                                    <div class="accordion-body">
                                        @if (categories != null)
                                        {
                                            foreach (var cat in categories)
                                            {
                                                <div>
                                                    <label class="custom_check">
                                                        <input type="checkbox" name="categoryFilter" value="@cat.Id" class="category-checkbox" />
                                                        <span class="checkmark"></span> @cat.Name (@cat.Count)
                                                    </label>
                                                </div>
                                            }
                                        }
                                        <a href="javascript:;" class="see-more-btn" id="clearAllFilters">Clear All</a>
                                    </div>
                                </div>
                            </div>
                            <!-- Price -->
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingPrice">
                                    <a href="#" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#collapsePrice">Price <i class="fa-solid fa-chevron-down"></i></a>
                                </h2>
                                <div id="collapsePrice" class="accordion-collapse collapse show" data-bs-parent="#filterAccordion">
                                    <div class="accordion-body">
                                        <div><label class="custom_check"><input type="radio" name="priceFilter" value="" class="price-radio" checked /> <span class="checkmark"></span> All</label></div>
                                        <div><label class="custom_check"><input type="radio" name="priceFilter" value="free" class="price-radio" /> <span class="checkmark"></span> Free</label></div>
                                        <div><label class="custom_check"><input type="radio" name="priceFilter" value="paid" class="price-radio" /> <span class="checkmark"></span> Paid</label></div>
                                        <div><label class="custom_check"><input type="radio" name="priceFilter" value="range" class="price-radio" id="priceRangeRadio" /> <span class="checkmark"></span> Range</label></div>
                                        <div class="mt-2 ms-3" id="priceRangeInputs" style="display:none;">
                                            <div class="d-flex gap-2 align-items-center">
                                                <input type="number" id="priceFrom" class="form-control form-control-sm" placeholder="From" min="0" step="0.01" style="width:80px;">
                                                <span>-</span>
                                                <input type="number" id="priceTo" class="form-control form-control-sm" placeholder="To" min="0" step="0.01" style="width:80px;">
                                                <button type="button" class="btn btn-sm btn-primary" id="applyPriceRange">Go</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Level -->
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingLevel">
                                    <a href="#" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#collapseLevel">Level <i class="fa-solid fa-chevron-down"></i></a>
                                </h2>
                                <div id="collapseLevel" class="accordion-collapse collapse show" data-bs-parent="#filterAccordion">
                                    <div class="accordion-body">
                                        <div><label class="custom_check"><input type="radio" name="levelFilter" value="" class="level-radio" checked /> <span class="checkmark"></span> All</label></div>
                                        @foreach (var lvl in Enum.GetValues(typeof(Level)).Cast<Level>())
                                        {
                                            <div>
                                                <label class="custom_check">
                                                    <input type="radio" name="levelFilter" value="@((int)lvl)" class="level-radio" />
                                                    <span class="checkmark"></span> @lvl
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-9">
                    <div class="showing-list mb-4">
                        <div class="row align-items-center">
                            <div class="col-lg-4">
                                <div class="show-result text-center text-lg-start">
                                    <h6 class="fw-medium" id="showingText">Loading...</h6>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Контейнер для AJAX-контента -->
                    <div id="coursesContainer">
                        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
                    </div>

                    <!-- Пагинация -->
                    <div class="row align-items-center mt-3">
                        <div class="col-md-2">
                            <p class="pagination-text" id="pageInfo"></p>
                        </div>
                        <div class="col-md-10">
                            <ul class="pagination lms-page justify-content-center justify-content-md-end mt-2 mt-md-0" id="paginationLinks"></ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        $(function () {
            let currentPage = 1;
            let totalPages = 1;

            // Загрузка курсов через AJAX
            function loadCourses(page) {
                var params = getFilterParams();
                params.page = page;

                $('#coursesContainer').html('<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>');

                $.get('/Course/ListAjax', params, function (response) {
                    renderCourses(response.courses);
                    renderPagination(response.currentPage, response.totalPages, response.totalCourses, response.pageSize);
                    currentPage = response.currentPage;
                    totalPages = response.totalPages;

                    // Обновляем URL без перезагрузки
                    var url = buildUrl(params);
                    history.pushState(params, '', url);
                });
            }

            // Сбор параметров фильтров
            function getFilterParams() {
                var params = {};
                var categoryId = $('.category-checkbox:checked').val();
                if (categoryId) params.categoryId = categoryId;
                var priceType = $('input[name="priceFilter"]:checked').val();
                if (priceType) params.priceType = priceType;
                var levelValue = $('input[name="levelFilter"]:checked').val();
                if (levelValue) params.level = levelValue;
                if (priceType === 'range') {
                    var priceFrom = $('#priceFrom').val();
                    var priceTo = $('#priceTo').val();
                    if (priceFrom) params.priceFrom = priceFrom;
                    if (priceTo) params.priceTo = priceTo;
                }
                return params;
            }

            // Построение URL для history.pushState
            function buildUrl(params) {
                var url = '/Course/List?page=' + (params.page || 1);
                for (var key in params) {
                    if (key !== 'page' && params[key]) {
                        url += '&' + key + '=' + encodeURIComponent(params[key]);
                    }
                }
                return url;
            }

            // Рендер карточек курсов
            function renderCourses(courses) {
                var html = '<div class="row course-list-wrap">';
                if (courses.length === 0) {
                    html += '<div class="col-12 text-center py-5"><p>No courses found.</p></div>';
                } else {
                    courses.forEach(function (course) {
                        html += `
                                    <div class="col-12">
                                        <div class="courses-list-item">
                                            <div class="d-md-flex align-items-center">
                                                <div class="position-relative overflow-hidden rounded-3 card-image">
                                                    <a href="/Course/Detail/${course.id}">
                                                        <img class="img-fluid rounded-3" src="${course.imagePath}" alt="${course.title}" onerror="this.onerror=null;this.src='/img/default.jpg';">
                                                    </a>
                                                    <div class="position-absolute start-0 top-0 d-flex align-items-start w-100 z-index-2 p-2">
                                                        <a href="javascript:;" class="like add-to-wishlist-btn" data-course-id="${course.id}">
                                                            <i class="isax isax-heart"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                                <div class="course-list-contents w-100 ps-0 ps-md-3 pt-4 pt-md-0">
                                                    <div class="d-flex flex-wrap align-items-center justify-content-between">
                                                        <div class="d-flex align-items-center">
                                                            <p><a href="#">${course.instructorName}</a></p>
                                                        </div>
                                                        <span><a class="tag-btn" href="#">${course.categoryName}</a></span>
                                                    </div>
                                                    <h4 class="mt-3 mb-2"><a href="/Course/Detail/${course.id}">${course.title}</a></h4>
                                                    <div class="d-flex align-items-center">
                                                        <p class="d-flex align-items-center mb-0">
                                                            <i class="fa-solid fa-star text-warning me-2"></i> ${course.avgRating.toFixed(1)} (${course.reviewCount} Reviews)
                                                        </p>
                                                        <span class="dot"></span>
                                                        <p>${course.levelForStudent}</p>
                                                    </div>
                                                    <div class="d-flex justify-content-between mt-3 align-items-center">
                                                        <h5 class="text-secondary">${course.oldPrice ? '<span class="text-decoration-line-through text-muted me-2">$' + course.oldPrice + '</span>' : ''}$${course.price}</h5>
                                                        <a href="/Course/Detail/${course.id}" class="btn btn-dark btn-sm d-inline-flex align-items-center">Get Course<i class="fs-8 fas fa-angle-right ms-2"></i></a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>`;
                    });
                }
                html += '</div>';
                $('#coursesContainer').html(html);
                $('#showingText').text(`Showing ${courses.length > 0 ? ((currentPage - 1) * 10 + 1) + '-' + ((currentPage - 1) * 10 + courses.length) : '0'} results`);
            }

            // Рендер пагинации
            function renderPagination(page, total, totalCourses, pageSize) {
                $('#pageInfo').text(`Page ${page} of ${total}`);

                var html = '';
                if (page > 1) {
                    html += `<li class="page-item prev"><a class="page-link" href="javascript:;" data-page="${page - 1}"><i class="fas fa-angle-left"></i></a></li>`;
                } else {
                    html += '<li class="page-item prev disabled"><a class="page-link" href="javascript:;"><i class="fas fa-angle-left"></i></a></li>';
                }

                for (var i = 1; i <= total; i++) {
                    if (i === page) {
                        html += `<li class="page-item active"><a class="page-link" href="javascript:;">${i}</a></li>`;
                    } else {
                        html += `<li class="page-item"><a class="page-link" href="javascript:;" data-page="${i}">${i}</a></li>`;
                    }
                }

                if (page < total) {
                    html += `<li class="page-item next"><a class="page-link" href="javascript:;" data-page="${page + 1}"><i class="fas fa-angle-right"></i></a></li>`;
                } else {
                    html += '<li class="page-item next disabled"><a class="page-link" href="javascript:;"><i class="fas fa-angle-right"></i></a></li>';
                }

                $('#paginationLinks').html(html);
            }

            // Обработчики событий
            $(document).on('click', '#paginationLinks a[data-page]', function () {
                var page = parseInt($(this).data('page'));
                loadCourses(page);
            });

            function applyFilters() {
                loadCourses(1);
            }

            $('.category-checkbox').on('change', function () {
                $('.category-checkbox').not(this).prop('checked', false);
                applyFilters();
            });

            $('input[name="priceFilter"]').on('change', function () {
                if ($(this).val() === 'range') {
                    $('#priceRangeInputs').slideDown(200);
                } else {
                    $('#priceRangeInputs').slideUp(200);
                    applyFilters();
                }
            });

            $('#applyPriceRange').on('click', applyFilters);
            $('#priceFrom, #priceTo').on('keypress', function (e) {
                if (e.which === 13) { e.preventDefault(); applyFilters(); }
            });

            $('.level-radio').on('change', applyFilters);

            $('#clearAllFilters').on('click', function () {
                $('.category-checkbox').prop('checked', false);
                $('input[name="priceFilter"][value=""]').prop('checked', true);
                $('input[name="levelFilter"][value=""]').prop('checked', true);
                $('#priceFrom, #priceTo').val('');
                applyFilters();
            });

            // Кнопки "назад/вперёд" браузера
            window.onpopstate = function (event) {
                if (event.state) {
                    loadCourses(event.state.page || 1);
                }
            };

            // Первая загрузка
            var initialPage = @ViewBag.CurrentPage ?? 1;
            loadCourses(initialPage);
        });
    </script>
}
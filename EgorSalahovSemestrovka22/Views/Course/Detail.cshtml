@model EgorSalahovSemestrovka22.Models.Entities.Course
@{
    ViewData["Title"] = Model.Title;
    var totalLessons = Model.Sections?.Sum(s => s.Lessons?.Count) ?? 0;
    var totalDuration = Model.Duration; // TimeSpan
}

<!-- Main Wrapper -->
<div class="main-wrapper">
    <!-- Breadcrumb -->
    <div class="breadcrumb-bar text-center">
        <div class="container">
            <div class="row">
                <div class="col-md-12 col-12">
                    <h2 class="breadcrumb-title mb-2">Course Detail</h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb justify-content-center mb-0">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item"><a asp-action="List">Courses</a></li>
                            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    <!-- /Breadcrumb -->

    <!-- Course detail -->
    <section class="course-details-two">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="card bg-light">
                        <div class="card-body d-lg-flex align-items-center">
                            <div class="position-relative">
                                <a href="#" id="openVideoBtn" target="_blank">
                                    <img class="img-fluid rounded-2" 
                                         src="@(string.IsNullOrEmpty(Model.ImagePath) || !Model.ImagePath.StartsWith("/") ? "/img/course/default.jpg" : Model.ImagePath)" 
                                         alt="@Model.Title"
                                         style="max-width:300px;" />
                                    @* Если есть видео, можно добавить play-icon *@
                                </a>
                            </div>
                            <div class="w-100 ps-lg-4">
                                <h3 class="mb-2">@Model.Title</h3>
                                <p class="fs-14 mb-3">@Model.ShortDescription</p>
                                <div class="d-flex align-items-center gap-2 gap-sm-3 gap-xl-4 flex-wrap my-3 my-sm-0">
                                    <p class="fw-medium d-flex align-items-center mb-0">
                                        <img class="me-2" src="~/img/icons/book.svg" alt="img">@totalLessons Lessons
                                    </p>
                                    @if (totalDuration.TotalMinutes > 0)
                                    {
                                        <p class="fw-medium d-flex align-items-center mb-0">
                                            <img class="me-2" src="~/img/icons/timer-start.svg" alt="img">
                                            @(totalDuration.Hours)hr @(totalDuration.Minutes)min
                                        </p>
                                    }
                                    <p class="fw-medium d-flex align-items-center mb-0">
                                        <img class="me-2" src="~/img/icons/people.svg" alt="img">
                                        @(Model.Enrollments?.Count ?? 0) students enrolled
                                    </p>
                                    <span class="badge badge-sm rounded-pill bg-warning fs-12">@Model.Category?.Name</span>
                                </div>
                                <div class="d-sm-flex align-items-center justify-content-sm-between mt-3">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar avatar-lg">
                                            @if (!string.IsNullOrEmpty(Model.Instructor?.AvatarPath))
                                            {
                                                <img class="rounded-circle" src="@Model.Instructor.AvatarPath" alt="img" />
                                            }
                                            else
                                            {
                                                <span class="d-flex align-items-center justify-content-center bg-secondary text-white rounded-circle" style="width:60px;height:60px;">
                                                    @Model.Instructor?.FirstName?.FirstOrDefault()@Model.Instructor?.LastName?.FirstOrDefault()
                                                </span>
                                            }
                                        </div>
                                        <div class="ms-2">
                                            <h5 class="fs-18 fw-semibold">
                                                @(Model.Instructor?.FirstName ?? "Instructor") @(Model.Instructor?.LastName ?? "")
                                            </h5>
                                            <p class="fs-14">Instructor</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-lg-8">
                    @if (!string.IsNullOrEmpty(Model.FullDescription))
                    {
                        <div class="card mb-4">
                            <div class="card-body">
                                <h5 class="mb-3">Overview</h5>
                                <h6 class="mb-2">Course Description</h6>
                                <div>@Html.Raw(Model.FullDescription)</div>
                            </div>
                        </div>
                    }

                    @if (Model.Sections != null && Model.Sections.Any())
                    {
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="d-flex justify-content-between flex-wrap">
                                    <h5 class="subs-title mb-2 mb-sm-3">Course Content</h5>
                                    <h6 class="fs-16 fw-medium text-gray-7 mb-3">@totalLessons Lectures</h6>
                                </div>
                                <div class="accordion accordion-customicon1 accordions-items-seperate p-0" id="sectionsAccordion">
                                    @{ int sectionIndex = 0; }
                                    @foreach (var section in Model.Sections)
                                    {
                                        var headingId = $"heading{sectionIndex}";
                                        var collapseId = $"collapse{sectionIndex}";
                                        <div class="accordion-item">
                                            <h2 class="accordion-header" id="@headingId">
                                                <button class="accordion-button @(sectionIndex > 0 ? "collapsed" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(sectionIndex == 0 ? "true" : "false")" aria-controls="@collapseId">
                                                    @(section.Title) <i class="fa-solid fa-chevron-down"></i>
                                                </button>
                                            </h2>
                                            <div id="@collapseId" class="accordion-collapse collapse @(sectionIndex == 0 ? "show" : "")" aria-labelledby="@headingId" data-bs-parent="#sectionsAccordion">
                                                <div class="accordion-body p-0">
                                                    <ul>
                                                        @foreach (var lesson in section.Lessons ?? new List<Lesson>())
                                                        {
                                                            <li class="p-4 px-3 d-flex justify-content-between">
                                                                <p class="mb-0"><img class="me-2" src="~/img/icons/play.svg" alt="img">@lesson.Title</p>
                                                                <div class="d-flex gap-xl-5 gap-3">
                                                                </div>
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                        sectionIndex++;
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div class="card mb-4">
                        <div class="card-body">
                            <h5 class="subs-title mb-4">About the instructor</h5>
                            <div class="d-flex align-items-center justify-content-between mt-4 gap-2 flex-wrap">
                                <div class="d-flex align-items-center">
                                    <div class="avatar avatar-lg">
                                        @if (!string.IsNullOrEmpty(Model.Instructor?.AvatarPath))
                                        {
                                            <img class="rounded-circle" src="@Model.Instructor.AvatarPath" alt="img" />
                                        }
                                        else
                                        {
                                            <span class="d-flex align-items-center justify-content-center bg-secondary text-white rounded-circle" style="width:60px;height:60px;">
                                                @Model.Instructor?.FirstName?.FirstOrDefault()@Model.Instructor?.LastName?.FirstOrDefault()
                                            </span>
                                        }
                                    </div>
                                    <div class="ms-2">
                                        <a href="#" class="name-link">@(Model.Instructor?.FirstName ?? "") @(Model.Instructor?.LastName ?? "")</a>
                                        <p class="mb-0 fs-14">@Model.Instructor?.Bio</p>
                                    </div>
                                </div>
                            </div>
                            <div class="course-info align-items-center d-flex gap-2 gap-xl-3 mt-3 mb-3 flex-wrap">
                                <p class="fw-medium d-flex align-items-center fs-14 mb-0">
                                    <img class="me-2" src="~/img/icons/play2.svg" alt="img">@ViewBag.InstructorCourseCount Courses
                                </p>
                                <p class="fw-medium d-flex align-items-center fs-14 mb-0">
                                    <img class="me-2" src="~/img/icons/book2.svg" alt="img">@totalLessons+ Lessons
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="course-sidebar-sec mt-0">
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    @if (Model.Price == 0)
                                    {
                                        <h2 class="text-success fs-30">FREE</h2>
                                    }
                                    else
                                    {
                                        <h2 class="text-secondary fs-30">
                                            @if (Model.OldPrice.HasValue)
                                            {
                                                <span class="text-decoration-line-through text-muted me-2">$@Model.OldPrice</span>
                                            }
                                            $@Model.Price
                                        </h2>
                                    }
                                </div>
                                <div class="d-flex justify-content-between gap-3 wishlist-btns">
                                    @if (User.Identity.IsAuthenticated && !User.IsInRole("Instructor"))
                                    {
                                        <button type="button" class="btn d-flex btn-wish add-to-wishlist-btn" data-course-id="@Model.Id">
                                            <i class="isax isax-heart me-1 fs-18"></i>Add to Wishlist
                                        </button>
                                    }
                                    else if (!User.Identity.IsAuthenticated)
                                    {
                                        <a asp-controller="Account" asp-action="SignIn" class="btn d-flex btn-wish">
                                            <i class="isax isax-heart me-1 fs-18"></i>Sign In to Add
                                        </a>
                                    }
                                </div>
                                @if (User.Identity.IsAuthenticated && !User.IsInRole("Instructor"))
                                {
                                    <button type="button" class="btn btn-primary w-100 mt-3 btn-enroll add-to-cart-btn" data-course-id="@Model.Id">
                                        <i class="isax isax-shopping-cart5 me-2"></i>Add to Cart
                                    </button>
                                }
                                else if (!User.Identity.IsAuthenticated)
                                {
                                    <a asp-controller="Account" asp-action="SignIn" class="btn btn-primary w-100 mt-3 btn-enroll">
                                        Sign In to Enroll
                                    </a>
                                }
                            </div>
                        </div>
                        <div class="card mb-4">
                            <div class="card-body">
                                <h5 class="subs-title mb-4">Includes</h5>
                                @if (Model.HasLifetimeAccess)
                                {
                                    <p class="mb-3"><img class="me-2" src="~/img/icons/key.svg" alt="img">Full lifetime access</p>
                                }
                                @if (Model.HasMobileAccess)
                                {
                                    <p class="mb-3"><img class="me-2" src="~/img/icons/monitor-mobbile.svg" alt="img">Access on mobile and TV</p>
                                }
                                @if (Model.HasAssignments)
                                {
                                    <p class="mb-3"><img class="me-2" src="~/img/icons/cloud-lightning.svg" alt="img">Assignments</p>
                                }
                                @if (Model.HasDownloadableResources)
                                {
                                    <p class="mb-3"><img class="me-2" src="~/img/icons/import.svg" alt="img">Downloadable resources</p>
                                }
                                @if (Model.HasSubtitles)
                                {
                                    <p class="mb-3"><img class="me-2" src="~/img/icons/play.svg" alt="img">Subtitles</p>
                                }
                                @if (Model.HasCommunityAccess)
                                {
                                    <p class="mb-3"><img class="me-2" src="~/img/icons/people2.svg" alt="img">Community access</p>
                                }
                            </div>
                        </div>
                        <div class="card">
                            <div class="card-body cou-features">
                                <h5 class="subs-title">Course Features</h5>
                                <ul>
                                    <li><p class="mb-0"><img class="me-2" src="~/img/icons/people2.svg" alt="img">Enrolled: @(Model.Enrollments?.Count ?? 0) students</p></li>
                                    @if (totalDuration.TotalMinutes > 0)
                                    {
                                        <li><p class="mb-0"><img class="me-2" src="~/img/icons/timer-start3.svg" alt="img">Duration: @(totalDuration.Hours)hr @(totalDuration.Minutes)min</p></li>
                                    }
                                    <li><p class="mb-0"><img class="me-2" src="~/img/icons/note.svg" alt="img">Chapters: @(Model.Sections?.Count ?? 0)</p></li>
                                    <li><p class="mb-0"><img class="me-2" src="~/img/icons/play3.svg" alt="img">Video: @totalLessons lectures</p></li>
                                    <li><p class="mb-0"><img class="me-2" src="~/img/icons/chart.svg" alt="img">Level: @Model.LevelForStudent</p></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card mb-4">
                    <div class="card-body text-center">
                        <h5 class="subs-title mb-3">Rate this course</h5>
                        <div class="rating-stars" id="rating-stars" data-course-id="@Model.Id">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="fa-star @(i <= (ViewBag.UserRating ?? 0) ? "fas text-warning" : "far") fs-24 me-1" data-rating="@i" style="cursor:pointer;"></i>
                            }
                        </div>
                        <p class="mt-2 mb-0">
                            Average: <strong id="avg-rating">@(Model.Reviews.Any() ? Model.Reviews.Average(r => r.Rating).ToString("0.0") : "0.0")</strong>
                            (<span id="reviews-count">@Model.Reviews.Count</span> reviews)
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts{
    <script>
        // Обновление счётчика корзины при загрузке страницы
        $(function () {
            updateCartCount();

            // Кнопка Add to Cart
            $(document).on('click', '.add-to-cart-btn', function () {
                var btn = $(this);
                var courseId = btn.data('course-id');
                btn.prop('disabled', true).text('Adding...');

                $.post('/Order/AddToCart', { courseId: courseId }, function (response) {
                    if (response.success) {
                        btn.removeClass('btn-primary').addClass('btn-success').text('Added to Cart!');
                        $('.count-icon').text(response.cartCount).show();
                        setTimeout(function () {
                            btn.removeClass('btn-success').addClass('btn-primary').html('<i class="isax isax-shopping-cart5 me-2"></i>Add to Cart').prop('disabled', false);
                        }, 2000);
                    } else {
                        alert(response.message);
                        btn.prop('disabled', false).html('<i class="isax isax-shopping-cart5 me-2"></i>Add to Cart');
                    }
                }).fail(function () {
                    alert('Error adding to cart');
                    btn.prop('disabled', false).html('<i class="isax isax-shopping-cart5 me-2"></i>Add to Cart');
                });
            });
        });

        function updateCartCount() {
            $.get('/Order/GetCartCount', function (data) {
                if (data.count > 0) {
                    $('.count-icon').text(data.count).show();
                } else {
                    $('.count-icon').text('0').hide();
                }
            });
        }

        // Кнопка Add to Wishlist
        $(document).on('click', '.add-to-wishlist-btn', function () {
            var btn = $(this);
            var courseId = btn.data('course-id');
            btn.prop('disabled', true).html('<i class="isax isax-heart me-1 fs-18"></i>Adding...');

            $.post('/Student/AddToWishlist', { courseId: courseId }, function (response) {
                if (response.success) {
                    btn.removeClass('btn-wish').addClass('btn-success').html('<i class="isax isax-heart5 me-1 fs-18"></i>Added!');
                    setTimeout(function () {
                        btn.removeClass('btn-success').addClass('btn-wish')
                            .html('<i class="isax isax-heart me-1 fs-18"></i>Add to Wishlist').prop('disabled', false);
                    }, 2000);
                } else {
                    alert(response.message);
                    btn.prop('disabled', false).html('<i class="isax isax-heart me-1 fs-18"></i>Add to Wishlist');
                }
            }).fail(function () {
                alert('Error adding to wishlist');
                btn.prop('disabled', false).html('<i class="isax isax-heart me-1 fs-18"></i>Add to Wishlist');
            });
        });

        // Рейтинг курса
        $(document).on('click', '#rating-stars .fa-star', function () {
            var rating = $(this).data('rating');
            var courseId = $('#rating-stars').data('course-id');
            var stars = $('#rating-stars .fa-star');

            stars.removeClass('fas text-warning').addClass('far');
            stars.each(function (index) {
                if (index < rating) {
                    $(this).removeClass('far').addClass('fas text-warning');
                }
            });

            $.post('/Course/RateCourse', { courseId: courseId, rating: rating }, function (response) {
                if (response.success) {
                    $('#avg-rating').text(response.average);
                    $('#reviews-count').text(response.count);
                } else {
                    alert(response.message);
                    location.reload(); // вернуть исходное состояние
                }
            }).fail(function () {
                alert('Error saving rating');
                location.reload();
            });
        });
    </script>
}
@model EgorSalahovSemestrovka22.Models.Entities.Orders.Order
@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="main-wrapper">
    <div class="breadcrumb-bar text-center">
        <div class="container">
            <div class="row">
                <div class="col-md-12 col-12">
                    <h2 class="breadcrumb-title mb-2">Order Confirmation</h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb justify-content-center mb-0">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item active">Confirmation</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <div class="content">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-body text-center p-5">
                            <i class="isax isax-tick-circle5 text-success" style="font-size: 64px;"></i>
                            <h3 class="mt-3">Order Placed Successfully!</h3>
                            <p class="text-muted">Order #@Model.Id</p>
                            <p>@Model.OrderDate.ToString("dd MMM yyyy, HH:mm")</p>
                            <hr>
                            <div class="text-start">
                                <h3 class="mb-4">Order Details</h3>
                                <ul class="list-unstyled fs-3">
                                    @foreach (var item in Model.OrderItems)
                                    {
                                        <li class="d-flex justify-content-between mb-4">
                                            <span>@item.Course.Title</span>
                                            <span class="fw-bold">$@item.PriceAtPurchase.ToString("0.00")</span>
                                        </li>
                                    }
                                </ul>
                                <hr>
                                <div class="d-flex justify-content-between fs-3 mb-3">
                                    <span>Tax</span>
                                    <span class="fw-bold">$@Model.Tax.ToString("0.00")</span>
                                </div>
                                <div class="d-flex justify-content-between mt-3" style="font-size: 2.5rem; font-weight: 800;">
                                    <span>Total</span>
                                    <span>$@Model.TotalAmount.ToString("0.00")</span>
                                </div>
                            </div>
                            @if (TempData["SuccessMessage"] != null)
                            {
                                <div class="alert alert-success mt-3">
                                    @TempData["SuccessMessage"]
                                </div>
                                TempData.Remove("SuccessMessage");
                            }
                            <a href="/Student/Courses" class="btn btn-primary btn-lg mt-4">Start Learning</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
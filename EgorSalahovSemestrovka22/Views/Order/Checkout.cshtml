@model List<EgorSalahovSemestrovka22.Models.Entities.Orders.CartItem>
@{
    ViewData["Title"] = "Checkout";
    var subtotal = (decimal)ViewBag.Subtotal;
    var tax = (decimal)ViewBag.Tax;
    var total = (decimal)ViewBag.Total;
}

<div class="main-wrapper">
    <!-- Breadcrumb -->
    <div class="breadcrumb-bar text-center">
        <div class="container">
            <div class="row">
                <div class="col-md-12 col-12">
                    <h2 class="breadcrumb-title mb-2">Checkout</h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb justify-content-center mb-0">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item"><a asp-action="Cart">Cart</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Checkout</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    <!-- /Breadcrumb -->

    <div class="content">
        <div class="container">
            <form asp-action="Checkout" method="post" id="checkout-form">
                <div class="checkout-content">
                    <div class="row">
                        <div class="col-lg-8">
                            <!-- Billing Address -->
                            <div class="checkout-item-1">
                                <div class="border-bottom pb-3 mb-3">
                                    <h5>Billing Address</h5>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="input-block">
                                            <label class="form-label">First Name<span class="text-danger">*</span></label>
                                            <input name="firstName" class="form-control" required>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-block">
                                            <label class="form-label">Last Name<span class="text-danger">*</span></label>
                                            <input name="lastName" class="form-control" required>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="input-block">
                                            <label class="form-label">Phone Number (Optional)</label>
                                            <input name="phone" class="form-control">
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="input-block">
                                            <label class="form-label">Address Line 1<span class="text-danger">*</span></label>
                                            <input name="addressLine1" class="form-control" required>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="input-block">
                                            <label class="form-label">Address Line 2 (Optional)</label>
                                            <input name="addressLine2" class="form-control">
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="input-block">
                                            <label class="form-label">Country<span class="text-danger">*</span></label>
                                            <input name="country" class="form-control" required>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="input-block">
                                            <label class="form-label">State<span class="text-danger">*</span></label>
                                            <input name="state" class="form-control" required>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="input-block">
                                            <label class="form-label">City<span class="text-danger">*</span></label>
                                            <input name="city" class="form-control" required>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Payment Method -->
                            <div class="checkout-item-1">
                                <div class="border-bottom pb-3 mb-3">
                                    <h5>Payment Method</h5>
                                </div>
                                <div class="d-flex gap-3 mb-3" id="payment-methods">
                                    <label class="btn btn-outline-secondary">
                                        <input type="radio" name="paymentMethod" value="Card" checked> Card
                                    </label>
                                    <label class="btn btn-outline-secondary">
                                        <input type="radio" name="paymentMethod" value="PayPal"> PayPal
                                    </label>
                                    <label class="btn btn-outline-secondary">
                                        <input type="radio" name="paymentMethod" value="Stripe"> Stripe
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <!-- Order Details -->
                            <div class="checkout-item-2">
                                <div class="pb-3 border-bottom mb-3">
                                    <h5 class="mb-0">Order Details</h5>
                                </div>
                                <div class="checkout-item-3 bg-light p-3 rounded-3 border mb-3">
                                    @foreach (var item in Model)
                                    {
                                        var course = item.Course;
                                        var imageUrl = string.IsNullOrEmpty(course.ImagePath) || !course.ImagePath.StartsWith("/")
                                            ? "/img/course/default.jpg" : course.ImagePath;
                                        <div class="d-flex align-items-center mb-2">
                                            <div class="order-img flex-shrink-0 me-3">
                                                <img src="@imageUrl" alt="@course.Title" style="width:60px;height:60px;object-fit:cover;" onerror="this.onerror=null;this.src='/img/course/default.jpg';">
                                            </div>
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1"><a href="#">@course.Title</a></h6>
                                                <span class="text-secondary">$@course.Price</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span>Sub Total</span>
                                    <span class="fw-medium">$@subtotal</span>
                                </div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span>Tax (13%)</span>
                                    <span class="fw-medium">$@tax</span>
                                </div>
                                <div class="total d-flex align-items-center justify-content-between border-top pt-2">
                                    <h6>Total</h6>
                                    <h4>$@total</h4>
                                </div>
                            </div>
                            <button type="button" class="btn btn-primary w-100 btn-lg" id="pay-button">
                                Pay $@total
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal confirmation -->
<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>You are about to pay <strong>$@total</strong> for @Model.Count course(s).</p>
                <p class="mb-0">Payment method: <span id="selected-payment-method">Card</span></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirm-payment-btn">Confirm Payment</button>
            </div>
        </div>
    </div>
</div>

<!-- Validation Errors Modal -->
<div class="modal fade" id="validationModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Validation Errors</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Please fill in the following required fields:</p>
                <ul id="validation-errors-list" class="text-danger mb-0"></ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // Обновляем надпись в модалке при выборе метода оплаты
            $('input[name="paymentMethod"]').on('change', function () {
                $('#selected-payment-method').text($(this).val());
            });

            // Валидация и открытие модалки подтверждения
            $('#pay-button').on('click', function () {
                var errors = [];
                var fields = [
                    { name: 'firstName', label: 'First Name' },
                    { name: 'lastName', label: 'Last Name' },
                    { name: 'addressLine1', label: 'Address Line 1' },
                    { name: 'country', label: 'Country' },
                    { name: 'state', label: 'State' },
                    { name: 'city', label: 'City' }
                ];

                fields.forEach(function (f) {
                    var val = $('[name="' + f.name + '"]').val().trim();
                    if (!val) {
                        errors.push(f.label + ' is required.');
                    }
                });

                if (errors.length > 0) {
                    // Показываем модалку с ошибками
                    var list = $('#validation-errors-list');
                    list.empty();
                    errors.forEach(function (err) {
                        list.append('<li>' + err + '</li>');
                    });
                    $('#validationModal').modal('show');
                } else {
                    // Открываем модалку подтверждения
                    $('#confirmModal').modal('show');
                }
            });

            // При клике на Confirm Payment отправляем форму
            $('#confirm-payment-btn').on('click', function () {
                $('#checkout-form').submit();
            });
        });
    </script>
}
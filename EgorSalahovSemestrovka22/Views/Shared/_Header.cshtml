	<style>
			/* CSS только для этого Home - отключаем hover */
			.main-nav .click-only:hover .submenu,
			.main-nav .click-only .submenu {
				display: none !important;
			}

			/* Показываем при открытом состоянии */
			.main-nav .click-only.open .submenu {
				display: block !important;
				z-index: 9999;
			}

			/* Иконка поворота при открытии */
			.main-nav .click-only.open a i.fa-chevron-down {
				transform: rotate(180deg);
				transition: transform 0.3s ease;
			}
	</style>

	<script>
			$(document).ready(function() {
				// Клик только для Home (.click-only)
				$('.main-nav .click-only > a').off('click.mega').on('click.mega', function(e) {
					e.preventDefault();
					e.stopPropagation();
        
					var $li = $(this).parent('.click-only');
					var $submenu = $li.find('.submenu');
        
					// Закрываем все остальные
					$('.main-nav .click-only').not($li).removeClass('open').find('.submenu').slideUp(200);
        
					// Toggle для этого
					if ($li.hasClass('open')) {
						$li.removeClass('open');
						$submenu.slideUp(200);
					} else {
						$li.addClass('open');
						$submenu.slideDown(200);
					}
				});
    
				// Закрытие при клике вне
				$(document).on('click', function(e) {
					if (!$(e.target).closest('.main-nav .click-only').length) {
						$('.main-nav .click-only').removeClass('open').find('.submenu').slideUp(200);
					}
				});
    
				// ESC закрывает
				$(document).keyup(function(e) {
					if (e.keyCode === 27) {
						$('.main-nav .click-only').removeClass('open').find('.submenu').slideUp(200);
					}
				});
			});
	</script>

<script>
		$(function () {
			updateCartCount();

			$(document).on('click', '.add-to-cart-btn', function () {
				var btn = $(this);
				var courseId = btn.data('course-id');
				btn.prop('disabled', true).text('Adding...');

				$.post('/Order/AddToCart', { courseId: courseId }, function (response) {
					if (response.success) {
						btn.removeClass('btn-primary').addClass('btn-success').text('Added to Cart!');
						$('.count-icon').text(response.cartCount).show();
						setTimeout(function () {
							btn.removeClass('btn-success').addClass('btn-primary').html('<i class="isax isax-shopping-cart5 me-2"></i>Add to Cart').prop('disabled', false);
						}, 2000);
					} else {
						alert(response.message);
						btn.prop('disabled', false).html('<i class="isax isax-shopping-cart5 me-2"></i>Add to Cart');
					}
				}).fail(function () {
					alert('Error adding to cart');
					btn.prop('disabled', false).html('<i class="isax isax-shopping-cart5 me-2"></i>Add to Cart');
				});
			});
		});

		function updateCartCount() {
			$.get('/Order/GetCartCount', function (data) {
				if (data.count > 0) {
					$('.count-icon').text(data.count).show();
				} else {
					$('.count-icon').text('0').hide();
				}
			});
		}
</script>


	<style>
			/* CSS только для этого Home - отключаем hover */
			.main-nav .click-only:hover .submenu,
			.main-nav .click-only .submenu {
				display: none !important;
			}

			/* Показываем при открытом состоянии */
			.main-nav .click-only.open .submenu {
				display: block !important;
				z-index: 9999;
			}

			/* Иконка поворота при открытии */
			.main-nav .click-only.open a i.fa-chevron-down {
				transform: rotate(180deg);
				transition: transform 0.3s ease;
			}
	</style>

	<script>
			$(document).ready(function() {
				// Клик только для Home (.click-only)
				$('.main-nav .click-only > a').off('click.mega').on('click.mega', function(e) {
					e.preventDefault();
					e.stopPropagation();
        
					var $li = $(this).parent('.click-only');
					var $submenu = $li.find('.submenu');
        
					// Закрываем все остальные
					$('.main-nav .click-only').not($li).removeClass('open').find('.submenu').slideUp(200);
        
					// Toggle для этого
					if ($li.hasClass('open')) {
						$li.removeClass('open');
						$submenu.slideUp(200);
					} else {
						$li.addClass('open');
						$submenu.slideDown(200);
					}
				});
    
				// Закрытие при клике вне
				$(document).on('click', function(e) {
					if (!$(e.target).closest('.main-nav .click-only').length) {
						$('.main-nav .click-only').removeClass('open').find('.submenu').slideUp(200);
					}
				});
    
				// ESC закрывает
				$(document).keyup(function(e) {
					if (e.keyCode === 27) {
						$('.main-nav .click-only').removeClass('open').find('.submenu').slideUp(200);
					}
				});
			});
	</script>
